---
import Layout from '../layouts/Layout.astro';
import '@/styles/globals.css'
import '@/styles/normalize.css'

import SpaceForSidebar from "@/components/SpaceForDesktopSidebar.astro"


---

<Layout title="Message Sent Successfully">
    <main class="flex">
        <SpaceForSidebar/>
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-4xl font-bold my-4">Thank You!</h1>
      <p class="text-xl mb-4" id="email-message">
          <!-- Email will be inserted here by JavaScript -->
        </p>
         <p class="text-lg mb-8">I'll get back to you soon.</p>
      <a href="/" class="px-6 py-3 bg-[#3C5DCA] text-white rounded-lg hover:opacity-90">
        Back to Home
      </a>
    </div>
  </main>
</Layout>

<script>
  // Read email from URL on the client side
  const urlParams = new URLSearchParams(window.location.search);
  const email = urlParams.get('email');
  
  const messageEl = document.getElementById('email-message');
  if (email && messageEl) {
    messageEl.innerHTML = `Your message from <strong>${email}</strong> has been successfully sent`;
  } else if (!email) {
       // No email = they didn't come from form submission
    window.location.href = '/#contact';
  }
</script>