---
import Layout from '../layouts/Layout.astro';
import '@/styles/globals.css'
import '@/styles/normalize.css'

import SpaceForSidebar from "@/components/SpaceForDesktopSidebar.astro"
const email = Astro.url.searchParams.get('email');
---

<Layout title="Message Sent Successfully">
    <main class="flex">
        <SpaceForSidebar/>
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-4xl font-bold my-4">Thank You!</h1>
     {email && (
        <p class="text-xl mb-4">
          We've received your message from <strong>{email}</strong>
        </p>
      )}
         <p class="text-lg mb-8">We'll get back to you soon.</p>
      <a href="/" class="px-6 py-3 bg-[#3C5DCA] text-white rounded-lg hover:opacity-90">
        Back to Home
      </a>
    </div>
  </main>
</Layout>