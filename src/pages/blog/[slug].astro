---
import { getCollection } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPublishedPosts } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const published = await getPublishedPosts();
  return posts.map(post => {
    const i = published.findIndex(p => p.slug === post.slug);
    return {
      params: { slug: post.slug },
      // published is newest-first, so the previous entry is the newer post.
      // Drafts (i === -1) get no navigation.
      props: {
        post,
        newer: i > 0 ? published[i - 1] : undefined,
        older: i >= 0 ? published[i + 1] : undefined,
      },
    };
  });
}

const { post, newer, older } = Astro.props;

if (!post) {
  throw new Error(`Post not found for slug: ${Astro.params.slug}`);
}

const { Content, headings } = await post.render();
---

<BlogPostLayout post={post} headings={headings} newer={newer} older={older}>
  <Content />
</BlogPostLayout>
