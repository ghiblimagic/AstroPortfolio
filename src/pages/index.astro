---
import Layout from '../layouts/Layout.astro';
import '@/styles/globals.css'
import '@/styles/normalize.css'

import HeroButtons from '@/components/landingpage/HeroButtons.astro'
import LatestProjects from '@/components/landingpage/LatestProjects.astro'
import DiamondBackgroundImages from "@/components/landingpage/DiamondBackgroundImages.astro"
import SpaceForDesktopSidebar from "@/components/SpaceForDesktopSidebar"
import GradientDivider from "@/components/ui/gradientDivider.astro";

---


<Layout title="Janet Spellman's Portfolio.">
	
		

<main class="h-full flex ">
	<!-- SpaceForDesktopSidebar's items are flex-none 
	  Div flexes to the remaining space
	-->

	<SpaceForDesktopSidebar client:media="(min-width: 1024px)"/>
	<div class="max-w-7xl">
		<section class=" pt-10 px-4 sm:px-12 text-center" id="home">
		
			
				<h1 class="font-Dancing text-4xl mb-4">Hi there!

					 <span class="wave" title="waving animated hand">&#128075; </span> I'm Janet, your next software engineer.
				
				</h1>

				<div class="background-tile mb-8 border-r-2 border-gray-300 ">

                <p > I bring a little "spellman magic" to every project I touch, creating personalized and user-friendly websites and applications.</p>

				<p class="mt-4"> You pour your heart into your business, and your website should reflect that. Let’s make it welcoming, performant, and memorable so first-time visitors feel excited to stick around and become loyal fans!</p>

				<p class="mt-4"> If you'd rather try to build it yourself, I made a guide to choose the right website builder for your business!

				</p>
			

					<HeroButtons/>
		
				</div>

				
			
					<section class="flex justify-center">
						
	                      	<h2 class="font-Dancing text-4xl"> My github activity</h2> 	

								<a href="https://github.com/ghiblimagic"
							  aria-label="link to github"
							 
							  >
							  <img
							  class="mx-1 inline-block size-7
							  hover:border-4 hover:rounded-sm hover:border-violet-500 md:size-8"
							  loading="eager"
							  src={`images/github.svg`}
							  alt="github logo"
							  title="github logo"
							/>
					</a>
					</section>
                 <div class="h-32">
					<img src="https://ghchart.rshah.org/2e1065/ghiblimagic" alt="Github chart" class="block mx-auto bg-violet-950 py-2 px-10 rounded-lg"/>
				 </div>
					
					

		</section>
   <!--  ******* Project Section ******** -->
   <section class="gradient-line mt-8 border-t-4 pt-10 px-4 sm:px-12" id="projects">
			<h2 class=" gradient-line font-Dancing text-4xl text-center"> Latest Projects </h2>

		
				 <LatestProjects>


		</section>
<!-- 		SERVICES SECTION -->

		<section class="gradient-line mt-8 border-t-4 pt-10  px-4 sm:px-12 mb-20" id="services">
			<h3 class="  gradient-line font-Dancing text-4xl text-center"> Services</h2>

		<div class="grid grid-cols-1 xl:grid-cols-2 gap-8 my-8 ml-4">

			<section class="flex mb-4">

<DiamondBackgroundImages imgSrc="service-palette"/>

					
				<div class="ml-6 background-tile">
					<h3 class="heading-styling ">Website Development </h3>
					<p > Your project deserves a tailored approach. I’ll begin by creating a wireframe shaped around your preferences, then bring it to life as a responsive website that feels right at home on phones, tablets, and big screens.</p>
				</div>
			</section>

			<section class="flex mb-4 ">
			
	
			<DiamondBackgroundImages imgSrc="responsive"/>
			
				<div class="ml-6 background-tile">
					<h3 class="heading-styling">Responsive Design</h3>
					<p>Keeping clients means giving them a smooth experience on any device. With responsive design, your website automatically adjusts to desktops, tablets, and mobile phones so your audience can navigate and purchase without frustration..</p>
				</div>
			</section>

			<section class="flex mb-4">

				<DiamondBackgroundImages imgSrc="accessiblity"/>

				<div class="ml-6 background-tile">
					<h3 class="heading-styling">Accessiblity </h3>
					<p> An accessible website creates a smoother experience for everyone.I build websites that are easy to navigate and inclusive, so every potential client can interact with your content without barriers.</p>
				</div>
			</section>

			

			<section class="flex mb-4">

				
						<DiamondBackgroundImages imgSrc="diamond"/>
				<div class="ml-6 background-tile">
					<h3 class="heading-styling border-b-0">Search Engine Optimization (SEO) </h3>
					<p> Strong SEO makes it easier for clients to find you. I optimize your site so it shows up higher in search results and brings more traffic your way. </p>
				</div>
			</section>

			


		</div>

	   </section>

	   <!-- THE PROCESS SECTION -->
	   <section class="gradient-line mt-8 border-t-4 pt-10  px-4 sm:px-12 " id="process">
	
	
		<h3 class=" gradient-line font-Dancing text-4xl text-center"> The Process</h2>
        
		<ol class="grid grid-cols-1 xl:grid-cols-2 gap-8 my-8">

			<li class="background-tile">
				<h3 class="heading-styling"> Step 1 : Consultation</h3>

				<p class="mb-2"> We will chat about your vision, needs, and expectations.</p>

				<p class=my-4"> We can either: 
					<ol>
					<li class="my-2 ml-2">
						1. Use a site builder so its easier for you to edit later (ex: Wix, Squarespace, Wordpress)
					</li>
					<li class="my-2 ml-2">
						2. Or I can code a custom site.
					</li>
				</ol>
						 </p>

				

				
			</li>
	
		
			<li class="content background-tile">
				<h3 class="heading-styling ">Step 2 : Proposal</h3>
				<p class="mb-4"> A personalized wire-frame layout will be created on figma so you can visually preview the site and suggest adjustments.</p>
				<img src="images/wireFrame.png" alt="a wireframe of NourishedByKeto showing a color palette and a preview of the home page" height="600"  decoding="async"
  loading="lazy"/>
			</li>
	
			<li class="content background-tile">
				<h3 class="heading-styling ">Step 3 : Creation and Adjustments </h3>
				<p> You will receive regular updates as the site is created, edited and tested. </p>
			</li>
	
			<li class="content background-tile">
				<h3 class="heading-styling"> Step 4 : Deployment</h3>
				<p> Your site will be deployed on a webhost (a webhost takes the code I write and turns it into a site). Congratulations, your site is now live!</p>

				
			</li>
		
		

   </section>

   <!-- LANGUAGES SECTION -->

   <section class="gradient-line mt-8 border-t-4 pt-10  px-4 sm:px-12" id="skills">

	<h2 class=" gradient-line grid-none font-Dancing text-4xl text-center"> Skills</h2>
 <div class="grid grid-cols-2 md:grid-cols-3 gap-8 my-8 justify-items-center">
	

	<section class="background-tile w-full"> 
		<h3 class="heading-styling"> Frameworks </h2>
		<ul>
			<li class="li-icons">Next JS 12-15</li>
			<li class="li-icons">Astro</li>
			<li class="li-icons">Gatsby</li>
		
		</ul>
	</section>

	<section class="background-tile w-full"> 

		<h3 class="heading-styling"> Languages</h2>
		<ul>
				<li class="li-icons">TypeScript</li>
			    <li class="li-icons">JavaScript</li>
				<li class="li-icons">Python</li>
				<li class="li-icons">GraphQL</li>
			    <li class="li-icons">HTML</li>
				<li class="li-icons">CSS</li>
		
		</ul>
	</section>


	<section class="background-tile w-full"> 
		<h3 class="heading-styling"> Back-End </h2>
		<ul>
				<li class="li-icons">Node.js</li>
				<li class="li-icons">Express</li>
				<li class="li-icons">MongoDB </li>
			
				<li class="li-icons">AppWrite</li>
				<li class="li-icons">PostMan</li>
				<li class="li-icons">Digital Ocean</li>
			
		</ul>
	</section>


	<section class="background-tile w-full"> 
		<h3 class="heading-styling"> Tools/Other </h2>
		<ul>
				<li class="li-icons">React</li>
				<li class="li-icons">TailwindCSS</li>
				<li class="li-icons">Git</li>
				<li class="li-icons">GitHub</li>
				<li class="li-icons">Figma</li>
				<li class="li-icons">Shopify</li>
				<li class="li-icons">Prettier</li>
				<li class="li-icons">Disquis</li>
				<li class="li-icons">Shadcn/ui</li>
				<li class="li-icons">Headless UI</li>
				<li class="li-icons">Daisy UI</li>
				<li class="li-icons">EJS</li>
				<li class="li-icons">GIMP</li>
			
				
		</ul>
	</section>

	<section class="background-tile w-full"> 
		<h3 class="heading-styling text-wrap"> CMS </h2>
		<ul>
			<li class="li-icons">WordPress</li>
			<li class="li-icons text-wrap">Decap cms</li>		
			
		</ul>
	</section>

		<section class="background-tile w-full"> 
		<h3 class="heading-styling"> AI </h2>
		<ul>
			<li class="li-icons">Open AI API</li>
			<li class="li-icons">ChatGPT</li>		
					<li class="li-icons">Claude</li>	
					<li class="li-icons">Co-pilot</li>		
			
		</ul>
	</section>




</div>
</section>

<GradientDivider style="ml-10"/>

<section class="my-12 py-8  px-8 bg-[#3c5dca] w-full  rounded-2xl max-w-4xl mx-auto " id="contact">

	<h2 class="heading font-Dancing text-4xl text-center text-white ">  Get in Touch</h2>

	<div class="flex flex-col items-center bg-white rounded-2xl shadow-lg shadow-blue-950  w-[95%] mx-auto max-w-xl">

	<p class="my-6">All fields marked with  <span class="text-red-800">*</span> are required</p>
	
	<form name="contact" method="POST"  data-netlify="true" netlify-honeypot  data-netlify-recaptcha="true"  action="/success" class="w-[90%]"> 
		<p class="hidden">
			<label>
			  Don’t fill this out if you’re human: <input name="bot-field" />
			</label>
		  </p>
		<div class="fields">
			<div class="field">
				<label for="name" class="block font-bold">Name  <span class="text-red-800">*</span></label>
				<input type="text" name="name" id="name" required class="w-full input-styling"/>
			</div>
			<div class="field">
				<label for="email" class="block font-bold">Email  <span class="text-red-800">*</span></label>
				<input type="text" name="email" id="email" required class="w-full input-styling"/>
			</div>

			<div class="field">
				<label for="phone" class="block font-bold"> Phone:</label>
				<input type="tel" name="phone" id="phone" class="w-full input-styling" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" 
				
				
				class="mr-2 input-styling"> 
				</input>
				<span class="block ">Format: 111-222-3333 </span>
			</div>
			

			<div class="field">
				<label for="message" class="block font-bold">Message <span class="text-red-800">*</span></label>
				<textarea name="message" id="message" rows="3" required class="input-styling w-full "></textarea>
			</div>
		</div>					

		 <div data-netlify-recaptcha="true"></div>
		
		<div class="flex align-center justify-center  w-full mb-11">
				<button
				type="submit" 
				title="click after filling out all required fields to submit contact request"			
				class="px-4 py-2 rounded-lg bg-[#3C5DCA] text-white hover:text-mainColor  animated-gradient hover:font-bold"
				>
				Send
		</button>
	
		</div>
	
	</form>

	

</div>

</section>

<div>

</main>



</Layout>
