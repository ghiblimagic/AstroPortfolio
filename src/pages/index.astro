<!--  so recaptcha will shrink on small screen -->
<style>
  .recaptcha-container {
    max-width: 100%;
    overflow: hidden;
    margin: 1rem 0;
	  display: flex;
    justify-content: center;
  }

  @media (max-width: 320px) {
    .recaptcha-container [data-netlify-recaptcha] > div > div {
      transform: scale(0.77);
      transform-origin: 0 0;
      margin-bottom: -20px; /* Compensate for scaled height */
    }
  }
</style>

<script is:inline>
  // is:inline is needed to Intercept Netlify's auto-injected reCAPTCHA script
  // because we need the script to run immediately during HTML parsing 
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      mutation.addedNodes.forEach((node) => {
        if (node.tagName === 'SCRIPT' && node.src && node.src.includes('recaptcha')) {
          // Don't load it immediately - defer until form is visible
          node.remove();
          
          const form = document.querySelector('form[name="contact"]');
          if (form) {
            const formObserver = new IntersectionObserver((entries) => {
              if (entries[0].isIntersecting) {
                document.head.appendChild(node);
                formObserver.disconnect();
                observer.disconnect();
              }
            }, { rootMargin: '200px' });
            
            formObserver.observe(form);
          }
        }
      });
    });
  });

  observer.observe(document.documentElement, { childList: true, subtree: true });
 
</script>



<section class="my-16 py-12 w-full bg-white" id="contact">
	<div class="max-w-4xl mx-auto px-4 sm:px-12">

	<h2 class="heading font-Ayaka text-4xl text-center fade-in">  Get in Touch</h2>
	<div class="bg-mainColor   sm:px-8 py-8 rounded-2xl max-w-2xl mx-auto fade-in"> 

	<div class="flex flex-col items-center bg-white rounded-2xl shadow-lg shadow-blue-950  sm:w-[95%] mx-auto max-w-xl fade-in">

	<p class="my-6 fade-in">All fields marked with  <span class="text-red-800">*</span> are required</p>
	
	<form name="contact" method="POST"  data-netlify="true" netlify-honeypot="bot-field"  data-netlify-recaptcha="true"  class="w-[90%]"> 
		  <input type="hidden" name="form-name" value="contact" />
		<p class="hidden">
			<label>
			  Don’t fill this out if you’re human: <input name="bot-field" />
			</label>
		  </p>
		<div class="fields text-left fade-in">
			<div class="field">
				<label for="name" class="block font-bold">Name  <span class="text-red-800">*</span></label>
				<input type="text" name="name" id="name" required class="w-full input-styling"/>
			</div>
			<div class="field ">
				<label for="email" class="block font-bold">Email  <span class="text-red-800">*</span></label>
				<input type="text" name="email" id="email" required class="w-full input-styling"/>
			</div>

			<div class="field">
				<label for="phone" class="block font-bold"> Phone:</label>
				<input type="tel" name="phone" id="phone" class="w-full input-styling" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" 
				
				
				class="mr-2 input-styling"> 
				</input>
				<span class="block ">Format: 111-222-3333 </span>
			</div>
			

			<div class="field">
				<label for="message" class="block font-bold">Message <span class="text-red-800">*</span></label>
				<textarea name="message" id="message" rows="3" required class="input-styling w-full "></textarea>
			</div>
		</div>					

		<div class="recaptcha-container fade-in">
		 <div data-netlify-recaptcha="true"></div>
		</div>

		<div class="flex align-center justify-center  w-full mb-11 fade-in">
				<button
				type="submit" 
				title="click after filling out all required fields to submit contact request"			
				class="px-4 py-2 rounded-lg bg-[#3C5DCA] text-white   animated-gradient hover:font-bold"
				>
				Send
		</button>
	
		</div>
	
	</form>

	<script>
  // Handle form submission - runs after form is in DOM
  const form = document.querySelector('form[name="contact"]') as HTMLFormElement;
  //  tells TypeScript the form element is a form, so it won't give this error when we tell it new FormData(form)
  // Argument of type 'Element' is not assignable to parameter of type 'HTMLFormElement'.  Type 'Element' is missing the following properties from type 'HTMLFormElement': acceptCharset, action, autocomplete, elements, and 148 more.
  
  if (form) {

	  const submitButton = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const email = formData.get('email') as string;

	      // Disable button and show loading state
      if (submitButton) {
        submitButton.textContent = 'Sending...';
        submitButton.setAttribute('disabled', 'true');
      }
      
      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(formData as any).toString()
        });
        
        if (response.ok) {
             // Using absolute URL to avoid trailing slash issues, 
			 // aka avoiding success/?email=f%40gmail.com and getting the correct success?email=f%40gmail.com 
          window.location.href = `${window.location.origin}/success?email=${encodeURIComponent(email)}`;
    
        } else {
          throw new Error('Form submission failed');
        }
      } catch (error) {
        console.error('Form submission error:', error);
        alert('There was an error submitting the form. Please try again.');

		  
        // Re-enable button
        if (submitButton) {
          submitButton.textContent = 'Send';
          submitButton.removeAttribute('disabled');
        }
      }
    });
  }
</script>
	

</div>
</div>

