<SectionDivider variant="hills" fromColor="var(--midnight-lavender-pale)" toColor="var(--midnight-navy)" midColor="var(--midnight-lavender)" />

<!--  so recaptcha will shrink on small screen -->
<style>
  .recaptcha-container {
    max-width: 100%;
    overflow: hidden;
    margin: 1rem 0;
	  display: flex;
    justify-content: center;
  }

  @media (max-width: 320px) {
    .recaptcha-container [data-netlify-recaptcha] > div > div {
      transform: scale(0.77);
      transform-origin: 0 0;
      margin-bottom: -20px; /* Compensate for scaled height */
    }
  }

  /* ---- Hero ---- */
  .hero-stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-star {
    position: absolute;
  }

  /* ---- GitHub chart card ---- */
  .github-chart-card {
    background: var(--midnight-white);
    border: 1px solid var(--midnight-lavender-border);
    border-radius: 18px;
    box-shadow: 0 12px 32px rgba(20, 27, 77, 0.08);
    padding: 24px 16px;
  }

  @media (min-width: 640px) {
    .github-chart-card {
      padding: 24px 40px;
    }
  }

  /* ---- Services ---- */
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
    background: var(--midnight-white);
    border: 1px solid var(--midnight-lavender-border);
    border-radius: 18px;
    padding: 74px 22px 24px;
    box-shadow: 0 12px 32px rgba(20, 27, 77, 0.08);
  }

  .service-card p {
    color: var(--midnight-text-body);
  }

  /* ---- Process ---- */
  .process-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 32px 0;
    list-style: none;
    padding: 0;
  }

  .process-steps::before {
    content: "";
    position: absolute;
    top: 28px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--midnight-lavender-mid);
    z-index: 0;
  }

  @media (max-width: 1023px) {
    .process-steps::before {
      display: none;
    }
  }

  .process-step {
    position: relative;
    z-index: 1;
  }

  .process-step p {
    color: var(--midnight-text-body);
  }

  .process-step__circle {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: 12px;
    border-radius: 999px;
    background: var(--midnight-navy);
    color: var(--midnight-white);
    font-family: "AkayaKanadaka Script", serif;
    font-size: 24px;
  }

  .process-wireframe {
    margin-top: 32px;
    text-align: center;
  }

  .process-wireframe img {
    margin: 0 auto;
  }

  @media (max-width: 1023px) {
    .process-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .process-steps {
      grid-template-columns: 1fr;
    }
  }

  /* ---- Skills ---- */
  .skills-section {
    padding-bottom: 230px;
  }

  @media (max-width: 640px) {
    .skills-section {
      padding-bottom: 140px;
    }
  }

  .skill-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
  }

  .skill-pills li {
    padding: 5px 12px;
    background: var(--midnight-white);
    border: 1px solid var(--midnight-lavender-border);
    border-radius: 999px;
    color: var(--midnight-navy);
    font-size: 14px;
  }

  /* ---- Contact ---- */
  .contact-section {
    position: relative;
  }

  .contact-stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .contact-star {
    position: absolute;
  }

  .contact-form-wrap {
    max-width: 620px;
    margin: 0 auto;
  }

  .contact-fields-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  @media (min-width: 640px) {
    .contact-fields-grid {
      grid-template-columns: 1fr 1fr;
    }

    .contact-field--full {
      grid-column: 1 / -1;
    }
  }

  .contact-label {
    display: block;
    margin-bottom: 4px;
    color: var(--midnight-text-light);
    font-size: 14px;
    font-weight: 600;
  }

  .contact-input {
    background: var(--midnight-navy-input);
    border: 1px solid var(--midnight-navy-line);
    border-radius: 10px;
    min-height: 48px;
    padding: 0 14px;
    color: var(--midnight-white);
  }

  .contact-textarea {
    min-height: 140px;
    padding: 12px 14px;
  }

  #contact input:focus,
  #contact textarea:focus,
  #contact button:focus {
    outline: 2px solid var(--midnight-lavender);
    outline-offset: 2px;
  }

  .contact-submit-btn {
    display: inline-block;
    border-radius: 10px;
    padding: 10px 28px;
    background: var(--midnight-lavender);
    color: var(--midnight-navy);
    font-family: "Inter", sans-serif;
    font-size: 14px;
    font-weight: 600;
    border: none;
    cursor: pointer;
  }

  .contact-submit-btn:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }
</style>

<script is:inline>
  // is:inline is needed to Intercept Netlify's auto-injected reCAPTCHA script
  // because we need the script to run immediately during HTML parsing 
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      mutation.addedNodes.forEach((node) => {
        if (node.tagName === 'SCRIPT' && node.src && node.src.includes('recaptcha')) {
          // Don't load it immediately - defer until form is visible
          node.remove();
          
          const form = document.querySelector('form[name="contact"]');
          if (form) {
            const formObserver = new IntersectionObserver((entries) => {
              if (entries[0].isIntersecting) {
                document.head.appendChild(node);
                formObserver.disconnect();
                observer.disconnect();
              }
            }, { rootMargin: '200px' });
            
            formObserver.observe(form);
          }
        }
      });
    });
  });

  observer.observe(document.documentElement, { childList: true, subtree: true });
 
</script>



<section class="contact-section mt-[-2px] p-4 sm:p-12 pb-20 sm:pb-32 w-full bg-[var(--midnight-navy)]" id="contact">
	<div class="contact-stars" aria-hidden="true">
		<svg class="contact-star twinkle" style="top:6%; left:5%; width:14px; height:14px; animation-delay:0.4s; animation-duration:4s;" viewBox="0 0 24 24" fill="#8A8FD0"><path d="M12 0 C13 8 16 11 24 12 C16 13 13 16 12 24 C11 16 8 13 0 12 C8 11 11 8 12 0Z"/></svg>
		<svg class="contact-star twinkle" style="top:8%; right:6%; width:18px; height:18px; animation-delay:1.7s; animation-duration:4.6s;" viewBox="0 0 24 24" fill="#8A8FD0"><path d="M12 0 C13 8 16 11 24 12 C16 13 13 16 12 24 C11 16 8 13 0 12 C8 11 11 8 12 0Z"/></svg>
		<svg class="contact-star twinkle" style="bottom:8%; left:8%; width:12px; height:12px; animation-delay:2.9s; animation-duration:3.7s;" viewBox="0 0 24 24" fill="#8A8FD0"><path d="M12 0 C13 8 16 11 24 12 C16 13 13 16 12 24 C11 16 8 13 0 12 C8 11 11 8 12 0Z"/></svg>
	</div>
	<div class="max-w-4xl mx-auto px-2 sm:px-12">

	<h2 class="heading font-Ayaka text-3xl sm:text-4xl text-center fade-in" style="color:var(--midnight-white);">  Get in Touch</h2>
	<p class="text-center fade-in" style="color:var(--midnight-text-light);">Hiring for a role or need a site built? Either way, I'd love to hear from you.</p>

	<div class="contact-form-wrap fade-in">

	<p class="my-6 fade-in" style="color:var(--midnight-text-light);">All fields marked with  <span class="text-red-300">*</span> are required</p>

	<form name="contact" method="POST"  data-netlify="true" netlify-honeypot="bot-field"  data-netlify-recaptcha="true"  class="w-full">
		  <input type="hidden" name="form-name" value="contact" />
		<p class="visually-hidden" aria-hidden="true">
			<label>
			  Don’t fill this out if you’re human: <input name="bot-field" tabindex="-1" autocomplete="off" />
			</label>
		  </p>
		<div class="fields text-left fade-in contact-fields-grid">
			<div class="field">
				<label for="name" class="contact-label">Name  <span class="text-red-300">*</span></label>
				<input type="text" name="name" id="name" required class="w-full contact-input"/>
			</div>
			<div class="field ">
				<label for="email" class="contact-label">Email  <span class="text-red-300">*</span></label>
				<input type="text" name="email" id="email" required class="w-full contact-input"/>
			</div>

			<div class="field contact-field--full">
				<label for="phone" class="contact-label"> Phone:</label>
				<input type="tel" name="phone" id="phone" class="w-full contact-input" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}">
				<span class="block" style="color:var(--midnight-text-light);">Format: 111-222-3333 </span>
			</div>


			<div class="field contact-field--full">
				<label for="message" class="contact-label">Message <span class="text-red-300">*</span></label>
				<textarea name="message" id="message" rows="5" required class="contact-input contact-textarea w-full "></textarea>
			</div>
		</div>

		<div class="recaptcha-container fade-in">
		 <div data-netlify-recaptcha="true"></div>
		</div>

		<div class="flex align-center justify-center  w-full mb-11 fade-in">
				<button
				type="submit"
				title="click after filling out all required fields to submit contact request"
				class="contact-submit-btn"
				>
				Send
		</button>

		</div>

	</form>

	<script>
  // Handle form submission - runs after form is in DOM
  const form = document.querySelector('form[name="contact"]') as HTMLFormElement;
  //  tells TypeScript the form element is a form, so it won't give this error when we tell it new FormData(form)
  // Argument of type 'Element' is not assignable to parameter of type 'HTMLFormElement'.  Type 'Element' is missing the following properties from type 'HTMLFormElement': acceptCharset, action, autocomplete, elements, and 148 more.
  
  if (form) {

	  const submitButton = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const email = formData.get('email') as string;

	      // Disable button and show loading state
      if (submitButton) {
        submitButton.textContent = 'Sending...';
        submitButton.setAttribute('disabled', 'true');
      }
      
      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(formData as any).toString()
        });
        
        if (response.ok) {
             // Using absolute URL to avoid trailing slash issues, 
			 // aka avoiding success/?email=f%40gmail.com and getting the correct success?email=f%40gmail.com 
          window.location.href = `${window.location.origin}/success?email=${encodeURIComponent(email)}`;
    
        } else {
          throw new Error('Form submission failed');
        }
      } catch (error) {
        console.error('Form submission error:', error);
        alert('There was an error submitting the form. Please try again.');

		  
        // Re-enable button
        if (submitButton) {
          submitButton.textContent = 'Send';
          submitButton.removeAttribute('disabled');
        }
      }
    });
  }
</script>


</div>

</div>
