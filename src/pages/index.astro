---
import Layout from '../layouts/Layout.astro';
import '@/styles/globals.css'
import '@/styles/normalize.css'

import Hero from '@/components/landingpage/Hero.astro'
import GithubActivity from '@/components/landingpage/GithubActivity.astro'
import LatestProjects from '@/components/landingpage/LatestProjects.astro'
import ServicesGrid from '@/components/landingpage/ServicesGrid.astro'
import ProcessSteps from '@/components/landingpage/ProcessSteps.astro'
import SkillsGrid from '@/components/landingpage/SkillsGrid.astro'
import ContactSection from '@/components/landingpage/ContactSection.astro'
import SpaceForDesktopSidebar from "@/components/SpaceForDesktopSidebar.astro"
import SectionDivider from "@/components/SectionDivider.astro"

---


<Layout title="Janet Spellman's Portfolio.">



<main id="main-content" tabindex="-1" class="h-full flex">
	<!-- SpaceForDesktopSidebar's items are flex-none
	  Div flexes to the remaining space
	-->

	<SpaceForDesktopSidebar/>
	<div class="min-w-0 flex-1">


		<section class="text-center w-full" id="home">

			<Hero />

			<SectionDivider variant="clouds" stars fromColor="var(--midnight-navy)" toColor="var(--midnight-lavender-pale)" />

			<!--  ******* Project Section ******** -->

			<section class="section-py bg-[var(--midnight-lavender-pale)]" id="projects">
				<div class="max-w-7xl mx-auto px-4 sm:px-12">
					<h2 class="font-Ayaka section-heading fade-in"> Latest Projects </h2>

					<LatestProjects />

				</div>
			</section>

			<!-- 				**********************	GITHUB   **********************-->
			<section class="section-py bg-[var(--midnight-lavender-pale)]" style="margin-top:-2px;">
				<div class="max-w-7xl mx-auto px-4 sm:px-12">

					<GithubActivity />

				</div>
			</section>

			<!-- 		SERVICES SECTION -->

			<section class="section-py bg-[var(--midnight-lavender-pale)]" id="services">
				<div class="max-w-7xl mx-auto px-4 sm:px-12">
					<h2 class="font-Ayaka section-heading fade-in"> Services</h2>

					<ServicesGrid />
				</div>
			</section>

			<!-- THE PROCESS SECTION -->

			<section class="section-py bg-[var(--midnight-lavender-pale)]" id="process">
				<div class="max-w-7xl mx-auto px-4 sm:px-12">

					<h2 class="font-Ayaka section-heading fade-in"> The Process</h2>

					<ProcessSteps />

				</div>
			</section>

			<!-- LANGUAGES SECTION -->

			<section class="skills-section section-py bg-[var(--midnight-lavender-pale)]" id="skills">
				<div class="max-w-7xl mx-auto px-4 sm:px-12">

					<h2 class=" grid-none font-Ayaka section-heading fade-in"> Skills</h2>

					<SkillsGrid />

				</div>
			</section>

			<SectionDivider variant="hills" fromColor="var(--midnight-lavender-pale)" toColor="var(--midnight-navy)" midColor="var(--midnight-lavender)" />

			<ContactSection />

<div>

</main>



</Layout>
