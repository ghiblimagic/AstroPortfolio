---
import Layout from '../layouts/Layout.astro';
import '@/styles/globals.css'
import '@/styles/normalize.css'
import SpaceForSidebar from "@/components/SpaceForDesktopSidebar.astro"
import SectionDivider from "@/components/SectionDivider.astro"
import ExternalLinkIcon from "@/components/ExternalLinkIcon.astro"

const STAR_PATH = "M12 0 C13 8 16 11 24 12 C16 13 13 16 12 24 C11 16 8 13 0 12 C8 11 11 8 12 0Z";

const INVITE_CODE = "sT85MV0n";
const SIGNUP_URL = `https://platform.torc.dev/#/r/${INVITE_CODE}/cp`;
const DISCORD_URL = "https://discord.gg/KrjRjNMxDu";
const LUMA_URL = "https://luma.com/user/torc";

const eventTypes = [
  { title: "Q&A livestreams", text: "Such as job search questions and resume reviews." },
  { title: "Live interviews", text: "With tech professionals." },
  { title: "Weekly networking", text: "Such as casual “yappy hours” on Fridays." },
  { title: "Discord events", text: "Community events such as game night." },
];

const previousEvents = [
  {
    title: "Interviews with Taylor Desseyn",
    subtitle: "and tech professionals",
    action: "Watch on LinkedIn",
    href: "https://www.linkedin.com/in/taylordesseyn/recent-activity/events/",
  },
  {
    title: "Interviews with Angelos Katrantzis",
    subtitle: "and tech professionals",
    action: "Watch on LinkedIn",
    href: "https://www.linkedin.com/in/angeloskatrantzis/recent-activity/events/",
  },
  {
    title: "Interviews with Ximena (Helenismoo) Cruz",
    subtitle: "and tech professionals",
    action: "Watch on LinkedIn",
    href: "https://www.linkedin.com/in/helenismoo/recent-activity/events/",
  },
  {
    title: "Vlogs from the Torc team",
    subtitle: "interviews and conferences",
    action: "Watch on YouTube",
    href: "https://www.youtube.com/@torcdotdev",
  },
];

// Header sparkles sit in the padding zones, well clear of the text and photo.
const headerStars = [
  { style: "top:36px; left:5%; width:20px; height:20px; animation-delay:0.4s; animation-duration:3.8s;" },
  { style: "top:44px; right:6%; width:16px; height:16px; animation-delay:1.6s; animation-duration:4.4s;" },
  { style: "bottom:110px; left:8%; width:16px; height:16px; animation-delay:2.2s; animation-duration:4.1s;" },
  { style: "bottom:120px; right:9%; width:22px; height:22px; animation-delay:0.9s; animation-duration:3.6s;" },
];

const readyStars = [
  { style: "top:28px; left:6%; width:16px; height:16px; animation-delay:0.6s; animation-duration:4.2s;" },
  { style: "top:44px; right:7%; width:12px; height:12px; animation-delay:1.9s; animation-duration:3.7s;" },
  { style: "bottom:30px; left:14%; width:12px; height:12px; animation-delay:2.7s; animation-duration:4.6s;" },
];
---

<Layout
  title="Join Torc | Janet Spellman"
  description="Why I'm a Torc Ambassador, and how to join Torc's free talent marketplace and tech community."
>
    <main id="main-content" tabindex="-1" class="flex">
        <SpaceForSidebar />
        <div class="torc-page min-w-0 flex-1 w-full">

            <!-- 1. Header -->
            <section class="torc-header" aria-labelledby="torc-heading">
                <div class="torc-stars" aria-hidden="true">
                    {headerStars.map((s) => (
                        <svg class="torc-star twinkle" style={s.style} viewBox="0 0 24 24" fill="var(--midnight-lavender)"><path d={STAR_PATH} /></svg>
                    ))}
                </div>
                <div class="torc-header__grid">
                    <div class="torc-header__text">
                        <p class="torc-badge">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="var(--midnight-lavender)" aria-hidden="true"><path d={STAR_PATH} /></svg>
                            TORC AMBASSADOR
                        </p>
                        <h1 id="torc-heading" class="torc-h1">Join Torc, a free and supportive tech community</h1>
                        <p class="torc-lead">I became a Torc Ambassador because I was impressed by the engaging and supportive community. Everyone genuinely wants to see you succeed, and that energy really comes through in the Discord chats and live events!</p>
                        <p class="torc-lead">A big reason I joined is to help bring more developers into this community, especially as so many go through layoffs and need this kind of space.</p>
                        <div class="torc-actions">
                            <a class="btn-primary" href={SIGNUP_URL} target="_blank" rel="noopener noreferrer">Join the talent marketplace<ExternalLinkIcon /><span class="visually-hidden"> (opens in a new tab)</span></a>
                            <a class="btn-secondary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Join the Discord<ExternalLinkIcon /><span class="visually-hidden"> (opens in a new tab)</span></a>
                        </div>
                    </div>
                    <div class="torc-photo">
                        <div class="torc-photo__shadow" aria-hidden="true"></div>
                        <img
                            class="torc-photo__img"
                            src="/images/ambassador.png"
                            width="380"
                            height="472"
                            alt="Smiling woman with the verified Torc Ambassador badge"
                            loading="eager"
                            fetchpriority="high"
                        />
                    </div>
                </div>
            </section>
            <SectionDivider variant="clouds" fromColor="var(--midnight-navy)" toColor="var(--midnight-lavender-pale)" />

            <!-- 2. Two things in one -->
            <section class="torc-two" aria-labelledby="two-heading">
                <div class="torc-inner">
                    <h2 id="two-heading" class="torc-h2 torc-h2--center">Two things in one</h2>
                    <p class="torc-intro">Torc is part of Randstad Digital. It's a talent marketplace and a community, and both are free.</p>
                    <div class="torc-cards">
                        <article class="torc-card">
                            <p class="torc-eyebrow">1 &middot; FIND WORK</p>
                            <h3 class="torc-h3">Talent marketplace</h3>
                            <p>A talent marketplace that matches tech professionals to roles. After you fill out your profile, it matches you to jobs that fit your skills.</p>
                            <p>Torc is mainly focused on North and Latin America right now, but the jobs can be anywhere globally.</p>
                            <div class="torc-code-box">
                                <p class="torc-code-box__label" id="invite-label">MY INVITE CODE</p>
                                <div class="torc-code-box__row">
                                    <code class="torc-code" aria-labelledby="invite-label" id="invite-code">{INVITE_CODE}</code>
                                    <button type="button" class="btn-primary btn-primary--sm" id="copy-code" data-code={INVITE_CODE}>Copy code</button>
                                </div>
                                <p class="torc-code-box__note">Using it helps me get a good grade as an ambassador (aka cool Torc merch)!</p>
                                <p class="visually-hidden" role="status" aria-live="polite" id="copy-status"></p>
                            </div>
                            <div class="torc-actions torc-actions--card">
                                <a class="btn-primary" href={SIGNUP_URL} target="_blank" rel="noopener noreferrer">Create your free profile<ExternalLinkIcon /><span class="visually-hidden"> (opens in a new tab)</span></a>
                            </div>
                        </article>
                        <article class="torc-card">
                            <p class="torc-eyebrow">2 &middot; MAKE FRIENDS &amp; GROW</p>
                            <h3 class="torc-h3">Community</h3>
                            <p>A community where tech professionals make friends with other professionals and improve their skills with weekly virtual talks and events.</p>
                            <p>All events are free, and usually virtual. The Discord is active, with a casual and supportive atmosphere.</p>
                            <div class="torc-actions torc-actions--card">
                                <a class="btn-primary" href={LUMA_URL} target="_blank" rel="noopener noreferrer">See upcoming events on Luma<ExternalLinkIcon /><span class="visually-hidden"> (opens in a new tab)</span></a>
                                <a class="btn-secondary btn-secondary--navy" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Join the Discord<ExternalLinkIcon /><span class="visually-hidden"> (opens in a new tab)</span></a>
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            <!-- 3. Types of events -->
            <section class="torc-events" aria-labelledby="types-heading">
                <div class="torc-inner">
                    <h2 id="types-heading" class="torc-h2 torc-h2--center">Types of events</h2>
                    <ul class="torc-types">
                        {eventTypes.map((e) => (
                            <li class="torc-type">
                                <svg class="torc-type__star" viewBox="0 0 24 24" fill="var(--midnight-navy)" aria-hidden="true"><path d={STAR_PATH} /></svg>
                                <h3 class="torc-h3 torc-h3--sm">{e.title}</h3>
                                <p>{e.text}</p>
                            </li>
                        ))}
                    </ul>
                    <div class="torc-reassure">
                        <p class="torc-reassure__label">FEELING NERVOUS?</p>
                        <p class="torc-reassure__text">Don't worry. You choose how much or how little you participate. For most events, the audience joins in through text channels.</p>
                    </div>
                </div>
            </section>

            <!-- 4. Previous events -->
            <section class="torc-previous" aria-labelledby="previous-heading">
                <div class="torc-inner">
                    <h2 id="previous-heading" class="torc-h2 torc-h2--center">Previous events</h2>
                    <p class="torc-intro">Want a taste of the Torc experience before joining the party? Watch some past events:</p>
                    <ul class="torc-links">
                        {previousEvents.map((e) => (
                            <li>
                                <a class="torc-link-card" href={e.href} target="_blank" rel="noopener noreferrer">
                                    <span class="torc-link-card__main">
                                        <span class="torc-link-card__title">{e.title}</span>
                                        <span class="torc-link-card__sub">{e.subtitle}</span>
                                    </span>
                                    <span class="torc-link-card__action">
                                        {e.action}<ExternalLinkIcon /><span class="visually-hidden"> (opens in a new tab)</span>
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </section>
            <SectionDivider variant="hills" fromColor="#ffffff" toColor="var(--midnight-navy)" midColor="var(--midnight-lavender)" />

            <!-- 5. Ready to join? -->
            <section class="torc-ready" aria-labelledby="ready-heading">
                <div class="torc-stars" aria-hidden="true">
                    {readyStars.map((s) => (
                        <svg class="torc-star twinkle" style={s.style} viewBox="0 0 24 24" fill="#8A8FD0"><path d={STAR_PATH} /></svg>
                    ))}
                </div>
                <h2 id="ready-heading" class="torc-h2 torc-h2--center torc-h2--light">Ready to join?</h2>
                <p class="torc-ready__sub">It's free. Start with a profile, drop into the Discord, or just lurk at an event. Whatever feels right.</p>
                <div class="torc-actions torc-actions--center">
                    <a class="btn-primary" href={SIGNUP_URL} target="_blank" rel="noopener noreferrer">Create your free profile<ExternalLinkIcon /><span class="visually-hidden"> (opens in a new tab)</span></a>
                    <a class="btn-secondary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Join the Discord<ExternalLinkIcon /><span class="visually-hidden"> (opens in a new tab)</span></a>
                    <a class="btn-secondary" href={LUMA_URL} target="_blank" rel="noopener noreferrer">Browse events<ExternalLinkIcon /><span class="visually-hidden"> (opens in a new tab)</span></a>
                </div>
            </section>

        </div>
    </main>
</Layout>

<script>
  const button = document.getElementById("copy-code") as HTMLButtonElement | null;
  const status = document.getElementById("copy-status");
  if (button && status) {
    let timer: number | undefined;
    button.addEventListener("click", async () => {
      window.clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(button.dataset.code ?? "");
        button.textContent = "Copied!";
        status.textContent = "Invite code copied";
      } catch (err) {
        console.error("Could not copy invite code", err);
        status.textContent = "Could not copy the invite code. Please select it and copy manually.";
        return;
      }
      timer = window.setTimeout(() => {
        button.textContent = "Copy code";
        status.textContent = "";
      }, 2000);
    });
  }
</script>
