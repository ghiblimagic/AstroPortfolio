---
import Layout from '../layouts/Layout.astro';
import '@/styles/globals.css'
import '@/styles/normalize.css'
import SpaceForSidebar from "@/components/SpaceForDesktopSidebar.astro"
import DescriptionAndLinks from "@/components/DescriptionAndLinks.astro"


const listOfPreviousEvents = [
  {
    description: "Interviews with Taylor Desseyn and tech professionals",
    href: "https://www.linkedin.com/in/taylordesseyn/recent-activity/events/"
  },

  {
    description: "Interviews with Angelos Katrantzis and tech professionals",
    href: "https://www.linkedin.com/in/angeloskatrantzis/recent-activity/events/"
  },
  {
    description: "Interviews with  Ximena (Helenismoo) Cruz and tech professionals",
    href: "https://www.linkedin.com/in/helenismoo/recent-activity/events/"
  },
  {
    description: "Vlogs of interviews and the Torc team at conferences",
    href: "https://www.youtube.com/@torcdotdev"
  }
]

---

<Layout title="Janet Spellman's About Me">

          
    
    <main class=" flex">
        <SpaceForSidebar/>
      <section class="min-w-0 flex-1 w-full mb-12">
       
         <!-- ################### WHY JOIN TORC ##################-->

           <section class="max-w-7xl mx-auto py-12 px-4 sm:px-12 flex flex-wrap gap-2">
                   <h2 class="font-Ayaka text-5xl mx-auto mb-4 " id="torc" > About Torc </h2>

                <div class="lg:flex">
                   <img src="/images/ambassador.png" alt="Smiling woman with the verified Torc Ambassador badge" class="max-h-[400px] mx-auto" />

                   <div>  <!-- div for flexed text on right START -->

                   <p class="lg:ml-4"> I became a Torc Ambassador because I was impressed by the engaging and supportive community. Everyone genuinely wants to see you succeed, and that energy really comes through in the Discord chats and live events! <p/>

                  <p class="lg:ml-4 my-4"> A big reason why I joined is to help bring more developers into this incredibly supportive community, especially as so many go through layoffs and desperately need this kind of space. <p/> 

                    <p class="w-full my-4 lg:ml-4"> Torc is part of RandStand Digital and is two things in one:</p>

                      <ol class="ml-4 lg:ml-8">
                          <li class="mb-2"> 1. A talent marketplace that matches tech professionals to roles </li>
                         <li> 2. A community where tech professionals can make friends with other professionals and improve their skills with weekly virtual talks and events</li>
                      </ol>
                
                    </div> <!-- div for flexed text on right END -->
                </div> 

               </section>

<!-- ################### Torc's Talent Marketplace ##################-->
<section class="text-center my-4 w-full bg-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-12">
                      <h3 class="font-Ayaka text-4xl  mb-2" id="torcs-talent-marketplace"> Torc's Talent Marketplace </h3>
                   
                    <p class="w-full text-center  mb-2"> After you fill out your profile, it will match you to any jobs that may match your skills. </p>

                        <p class="w-full text-center  mb-2"> Torcs mainly focused on North and Latin America right now, but the jobs can be anywhere globally. </p>

                                     <p class="w-full text-center  mb-2"> 
If you want to help me get a good grade in "ambassador" please use my invite code when signing up sT85MV0n (aka help me get cool Torc merch). 
 </p>

                 <p class="w-full text-center  mb-2"> To join the free talent marketplace, you can make a profile here: </p>
                   <p  class="w-full text-center  mb-4">
                      <a href="https://platform.torc.dev/#/r/sT85MV0n/cp"> <span> Click <strong>here </strong> </a> <span> 
                   </p>
<!-- 
                                <img src="/images/TorcPlatform.png" class="mx-auto max-w-[600px] w-full" alt="screenshot of the dashboard page for Torc, which says if you profile is complete or not"> -->
  </div>
</section>

<section class="fade-in text-center py-12 w-full">
  <div class="max-w-7xl mx-auto px-4 sm:px-12">
                             <h3 class="font-Ayaka text-4xl  mb-4  " id="torcs-community-page" > Torc's Community Page </h3>

                     <p class="w-full text-center mb-2"> To see the weekly virtual events check out the Torc's Luma Page!  All events are <strong> free! </strong> And usually virtual. </p>
                     
                          <p  class="w-full text-center  mb-2">
                        <a href="https://luma.com/user/torc" > <span> Click <strong>here </strong></a> <span> 
                  
                         </p>

                     <p class="text-center w-full  mb-2"> Join the discord! It's active with a casual and supportive atmosphere. </p>

                          <p  class="w-full text-center  mb-2">
                        <a href="https://discord.gg/KrjRjNMxDu"> <span> Click <strong>here </strong></a> <span> 
                  
                         </p>
                        
                  
  </div>
</section>

         <section class="fade-in text-center my-3 w-full bg-white py-12">
           <div class="max-w-7xl mx-auto sm:px-12">
                    <h3 class="text-center font-Ayaka text-4xl mb-4" id="torcs-type-of-events"> Types of Events: </h3>

                        <p class="flex text-center">
                        
                        <ul class="list-disc list-inside mx-auto  pl-6 md:pl-0"> 
                            <li class="mb-4"> Q&As Live streams such as job search questions and resume reviews </li> 
                            <li class="mb-4">  Live interviews with tech professionals </li> 
                            <li class="mb-4">  Weekly networking events, such as casual "yappy hours" on fridays </li>
                            <li> Discord community events such as game night </li> 
                        </ul>
                     </p>

         </div>
       </section>
      
        <section class="fade-in text-center py-12 w-full">
          <div class="max-w-7xl mx-auto px-4 sm:px-12">
                     <h4 class="font-Ayaka text-4xl mb-4" id="torcs-previous-events"> Previous Events </h4>                  
                     
                    <section class="w-full text-center">

                         <p class="mb-6"> Want a taste of the Torc experience before commiting to joining the party? View Previous events: </p>

                    
                    
                            <DescriptionAndLinks list={listOfPreviousEvents}/>            
                                     


                  
                         <p class="text-center mt-6">Feeling nervous? Don't worry you can choose how much or little you want to participate! </p>
                         <p class="text-center mb-6">For most events, the audience participates through text channels. </p>

                        <img src="/images/TorcCalender.png" class="w-full mx-auto max-w-[800px]" alt="calender showing upcoming virtual events">
</section>

                    
          </div>
         </section>
      </main>


    </div>
</Layout>