---
import Layout from '../layouts/Layout.astro';
import '@/styles/globals.css'
import '@/styles/normalize.css'
import SpaceForSidebar from "@/components/SpaceForDesktopSidebar.astro"
import DescriptionAndLinks from "@/components/DescriptionAndLinks.astro"


const listOfPreviousEvents = [
  {
    description: "Interviews with Taylor Desseyn and tech professionals",
    href: "https://www.linkedin.com/in/taylordesseyn/recent-activity/events/"
  },
  {
    description: "Interviews, coding challenges and other events with Jason Torres",
    href: "https://www.twitch.tv/jasonetorres/videos"
  },
  {
    description: "Interviews with Angelos Katrantzis and tech professionals",
    href: "https://www.linkedin.com/in/angeloskatrantzis"
  },
  {
    description: "Interviews with  Ximena (Helenismoo) Cruz and tech professionals",
    href: "https://www.linkedin.com/in/helenismoo/recent-activity/events/"
  },
  {
    description: "Vlogs of interviews and the Torc team at conferences",
    href: "https://www.youtube.com/@torcdotdev"
  }
]

---

<Layout title="Janet Spellman's About Me">

          
    
    <main class=" flex">
        <SpaceForSidebar/>
       <section class="mb-12">
       
         <!-- ################### WHY JOIN TORC ##################-->

           <section class="pt-4 px-2 my-2 md:px-12 flex flex-wrap gap-2">
                   <h2 class="font-Rancho text-5xl mx-auto mb-4 " id="torc" > About Torc </h2>

                <div class="lg:flex">
                   <img src="/images/ambassador.png" class="max-h-[400px] mx-auto" />

                   <div>  <!-- div for flexed text on right START -->

                   <p class="lg:ml-4"> I became a Torc Ambassador because I was impressed by the engaging and supportive community. Everyone genuinely wants to see you succeed, and that energy really comes through in the Discord chats and live events! <p/>

                  <p class="lg:ml-4 my-4"> A big reason why I joined is to help bring more developers into this incredibly supportive community, especially as so many go through layoffs and desperately need this kind of space. <p/> 

                    <p class="w-full my-4 lg:ml-4"> Torc is part of RandStand Digital and is a:</p>

                      <ol class="ml-4 lg:ml-8">
                          <li class="mb-2"> 1. A talent marketplace that matches tech professionals to roles </li>
                         <li> 2. A community where tech professionals can make friends with other professionals and improve their skills with weekly virtual talks and events</li>
                      </ol>
                
                    </div> <!-- div for flexed text on right END -->
                </div> 

<!-- ################### Torc's Talent Marketplace ##################-->

                      <h3 class="font-Rancho text-4xl text-center my-4 w-full " id="torcs-talent-marketplace"> Torc's Talent Marketplace </h5>
                   

                   <p class="w-full text-center"> To join the free talent marketplace, you can make a profile here: </p>
                   <p  class="w-full text-center">
                      <a href="https://platform.torc.dev/#/r/sT85MV0n/cp"> <span> Click <strong>here </strong> 👈 </a> or copy this link<span>  https://platform.torc.dev/#/r/sT85MV0n/cp 
                   </p>
                                <img src="/images/TorcPlatform.png"/ class="mx-auto max-w-[600px] w-full" alt="screenshot of the dashboard page for Torc, which says if you profile is complete or not">

                             <h3 class="font-Rancho text-4xl text-center my-6 w-full " id="torcs-community-page" > Torc's Community Page </h3>

                     <p class="w-full text-center"> To see the weekly virtual events check out the Torc Community page!</p>
                     
                     <p class="text-center w-full"> You can also <strong>click the link at the top of the page to join the active discord</strong>. All events are <strong> free! </strong>  </p>
                        
                       <p  class="w-full text-center">
                        <a href="https://cal.torc.dev/" > <span> Click <strong>here 👈</strong></a> or copy this link <span>  <span>  https://cal.torc.dev/ </span>
                  
                         </p>

                    <h4 class="text-center w-full font-Rancho text-4xl my-6" id="torcs-type-of-events"> Types of Events: </h4>

                        <p class="flex text-center">
                        
                        <ul class="list-disc mx-auto  pl-6 md:pl-0"> 
                            <li class="mb-2"> Live streams of Q&As such as job search questions and resume reviews </li> 
                            <li class="mb-2">  Live interviews with tech professionals </li> 
                            <li class="mb-2">  Weekly networking events </li>
                            <li> Discord community events such as game night </li> 
                        </ul>
                     </p>

                  
                     <h4 class="font-Rancho text-4xl text-center w-full my-6" id="torcs-previous-events"> Previous Events </h4>                  
                     
                    <section class="w-full text-center">

                         <p class="mb-6"> Want a taste of the Torc experience before commiting to joining the party? View Previous events: </p>

                    
                    
                            <DescriptionAndLinks list={listOfPreviousEvents}/>            
                                     


                  
                         <p class="text-center mt-6">Feeling nervous? don't worry you can choose how much or little you want to participate! </p>
                         <p class="text-center mb-6">For most events, the audience participates through text channels. </p>

                        <img src="/images/TorcCalender.png"/ class="w-full mx-auto max-w-[800px]" alt="screenshot of the calender showing upcoming virtual events">
</section>
                    
         </section>
        </section>
    </main>


    </div>
</Layout>