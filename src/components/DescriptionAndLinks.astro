---
interface ListItem {
  description: string;
  href: string;
}

interface Props {
  list: ListItem[];
}

const { list } = Astro.props;
---

<div class="mx-auto">
  <ul class="list-disc w-full pl-6 md:pl-0">
    {list.map((item) => (
      <li class="mb-2">
        {item.description}
        <div>
          <a href={item.href}>
            <span>
              Click <strong>here 👈 </strong>
            </span>
          </a>
          {` or copy: ${item.href}`}
        </div>
      </li>
    ))}
  </ul>
</div>