---
interface Props {
  aria?: string;
  link: string;
  target?: string;
  rel?: string;
  text: string;
  primary?: boolean;
  secondary?: boolean;
}

const { aria, link, target = "", rel = "", text, primary, secondary } = Astro.props;

const primaryButton = "portfolio-button--view";
const secondaryButton = "portfolio-button--code";
const tertiaryButton = "portfolio-button--link";

const styling = primary 
  ? primaryButton 
  : secondary 
    ? secondaryButton 
    : tertiaryButton;
---

<a
  class={`portfolio-button ${styling} my-auto text-center not-prose`}
  aria-label={aria}
  href={link}
  target={target}
  rel={rel}

>
  {text}
</a>