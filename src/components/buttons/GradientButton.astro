---
interface Props {
  aria?: string;
  link: string;
  target?: string;
  rel?: string;
  text: string;
  primary?: boolean;
  secondary?: boolean;
}

const { aria, link, target = "", rel = "", text, primary, secondary } = Astro.props;

const primaryButton = "bg-mainColor text-white";
const secondaryButton = "border-2 text-blue-700 border-mainColor";
const tertiaryButton = "underline underline-offset-4 decoration-mainColor text-blue-700 hover:no-underline";

const styling = primary 
  ? primaryButton 
  : secondary 
    ? secondaryButton 
    : tertiaryButton;
---

<a
  class={`inline-block px-4 py-2 m-1 rounded-2xl ${styling} my-auto  animated-gradient hover:font-bold text-center not-prose`}
  aria-label={aria}
  href={link}
  target={target}
  rel={rel}

>
  {text}
</a>