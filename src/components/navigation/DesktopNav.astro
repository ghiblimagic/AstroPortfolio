---

import { Image } from 'astro:assets'
import logo from '../../../public/images/transparent-logo-bright-small.webp'

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || (path === '/blog' && currentPath.startsWith('/blog/'));

---

<div>
  {/* ********************    MAIN NAV, DOTTED BACKGROUND*****************  */}
<div
  id="sidebar"
  class="fixed left-0 top-0 w-[250px] h-screen bg-[#1334a0] px-6 pt-16 z-51 text-white border-r-4 overflow-y-auto"

>
    <div class="flex  items-center gap-4 py-4 glow ">
  <Image
  src={logo}
  alt="logo for spellman's consulting its a blue code symbol </> with a wand in place of the slash"
  width={40}
  height={40}
  loading="eager"
  fetchpriority="high"
  class=" ml-2 box-content  rounded-full hover:border-white hover:rounded-full hover:bg-white "
/>
      <p class="font-Akaya ">
        <span class="inline-block text-white text-xl lg:text-xl xl:text-2xl text-end"> Spellman's </span>
        <span class="inline-block text-white text-xl lg:text-xl xl:text-2xl "> Consulting</span>
      </p>
    </div>
    
  <ul class="flex flex-col text-center font-Akaya text-xl lg:text-xl xl:text-2xl [&>li]:py-1 xl:[&>li]:py-2">
      <li class="glow  my-auto">
        <a class:list={['block rounded-lg px-3 py-1', { 'nav-link-active': isActive('/') }]} href="/">
        Home
        </a>
      </li>
      
      <li class="glow ">
        <a href="/#projects">
         Projects
        </a>
      </li>
      
      
      <li class="glow ">
        <a class:list={['block rounded-lg px-3 py-1', { 'nav-link-active': isActive('/about/') }]} href="/about/">About</a>
      </li>
      
      <li class="glow ">
        <a href="/#services">
          Services
        </a>
      </li>
      
      <li class="glow ">
        <a href="/#process">The Process</a>
      </li>
      
      <li class="glow ">
        <a href="/#skills">Skills</a>
      </li>
      
      <li class="glow ">
        <a href="/#contact">Contact</a>
   
      
      <li class="glow ">
        <a class:list={['block rounded-lg px-3 py-1', { 'nav-link-active': isActive('/blog') }]} href="/blog">Blog</a>
      </li>

      
      <li class="glow ">
        <a class:list={['block rounded-lg px-3 py-1', { 'nav-link-active': isActive('/torc') }]} href="/torc">Torc</a>
      </li>
    </ul>
    
    <div class="flex flex-col space-y-5 items-center justify-items-center pt-8"></div>
  </div>
</div>