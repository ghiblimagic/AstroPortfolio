---

import { Image } from 'astro:assets'
import logo from '../../../public/images/transparent-logo-bright-small.png'

---

<div>
  {/* ********************    MAIN NAV, DOTTED BACKGROUND*****************  */}
  <div
    id="sidebar"
    class="fixed left-0 top-0 w-[250px] h-screen bg-mainColor pt-14 p-6 z-51 text-white border-r-4 gradient-line"
    style="background-image: url('/images/dotsBackground.png')"
  >
    <div class="flex  items-center  bg-violet-900 gradient-line border-2 py-4 glow">
  <Image
  src={logo}
  alt="logo for spellman's consulting its a blue code symbol </> with a wand in place of the slash"
  width={40}
  height={40}
  loading="eager"
  fetchpriority="high"
  class="bg-violet-900 box-content  rounded-full hover:border-white hover:rounded-full hover:bg-white ml-2"
/>
      <p class="ml-2 font-Dancing">
        <span class="inline-block text-white text-[30px]"> Spellman's </span>
        <span class="inline-block text-white text-[30px]"> Consulting</span>
      </p>
    </div>
    
    <ul class="flex flex-col space-y-3 pt-6 bg-[#3c5dca] text-center font-Dancing text-2xl">
      <li class="glow gradient-line border-b-2 pb-1">
        <a href="/#home">
          <span class="text-center">Home</span>
        </a>
      </li>
      
      <li class="glow gradient-line border-b-2 pb-1">
        <a href="/#projects">
          <span>Projects</span>
        </a>
      </li>
      
      
      <li class="glow gradient-line border-b-2 pb-1">
        <a href="/about/">About me</a>
      </li>
      
      <li class="glow gradient-line border-b-2 pb-1">
        <a href="/#services">
          <span>Services</span>
        </a>
      </li>
      
      <li class="glow gradient-line border-b-2 pb-1">
        <a href="/#process">The Process</a>
      </li>
      
      <li class="glow gradient-line border-b-2 pb-1">
        <a href="/#skills">Skills</a>
      </li>
      
      <li class="glow gradient-line border-b-2 pb-1">
        <a href="/#contact">Contact</a>
      </li>
      
      <li class="glow gradient-line border-b-2 pb-1">
        <a href="/blog">Blog</a>
      </li>
      
      <li class="glow gradient-line border-b-2 pb-1">
        <a href="/torc">Torc</a>
      </li>
    </ul>
    
    <div class="flex flex-col space-y-5 items-center justify-items-center pt-8"></div>
  </div>
</div>