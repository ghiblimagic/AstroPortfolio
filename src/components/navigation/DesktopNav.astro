---

import { Image } from 'astro:assets'
import logo from '../../../public/images/transparent-logo-bright-small.webp'
import ConstellationNav from './ConstellationNav.astro'

---

<div>
  {/* ********************    MAIN NAV, DOTTED BACKGROUND*****************  */}
<nav
  id="desktop-nav"
  aria-label="Main"
  class="fixed left-0 top-0 w-[250px] h-screen bg-[var(--midnight-navy)] px-6 pt-16 z-51 text-white overflow-y-auto"
  style="border-right: 1px solid rgba(179,174,234,0.18);"

>
    <div class="flex items-center justify-center gap-4 py-4 glow ">
  <Image
  src={logo}
  alt="logo for spellman's consulting its a blue code symbol </> with a wand in place of the slash"
  width={40}
  height={40}
  loading="eager"
  fetchpriority="high"
  class="box-content rounded-full hover:border-white hover:rounded-full hover:bg-white "
/>
      <p class="font-Akaya text-center">
        <span class="inline-block text-white text-xl lg:text-xl xl:text-2xl text-end"> Spellman's </span>
        <span class="inline-block text-white text-xl lg:text-xl xl:text-2xl "> Consulting</span>
      </p>
    </div>

    <div class="relative pb-[72px] text-xl xl:text-2xl">
      <ConstellationNav />

      {/* Decorative background sparkles - purely visual, kept clear of
          the constellation's stars/labels so they never read as part of
          the nav line. */}
      <div class="sidebar-sparkles" aria-hidden="true">
        <svg class="sidebar-sparkle twinkle" style="top:14px; right:10px; width:10px; height:10px; animation-delay:0.5s; animation-duration:3.8s;" viewBox="0 0 24 24" fill="#D6D3F7"><path d="M12 0 C13 8 16 11 24 12 C16 13 13 16 12 24 C11 16 8 13 0 12 C8 11 11 8 12 0Z"/></svg>
        <svg class="sidebar-sparkle twinkle" style="top:264px; right:14px; width:8px; height:8px; animation-delay:1.8s; animation-duration:4.2s;" viewBox="0 0 24 24" fill="#D6D3F7"><path d="M12 0 C13 8 16 11 24 12 C16 13 13 16 12 24 C11 16 8 13 0 12 C8 11 11 8 12 0Z"/></svg>
        <svg class="sidebar-sparkle twinkle" style="bottom:36px; left:20px; width:12px; height:12px; animation-delay:0.9s; animation-duration:4.6s;" viewBox="0 0 24 24" fill="#D6D3F7"><path d="M12 0 C13 8 16 11 24 12 C16 13 13 16 12 24 C11 16 8 13 0 12 C8 11 11 8 12 0Z"/></svg>
        <svg class="sidebar-sparkle twinkle" style="bottom:14px; left:70px; width:9px; height:9px; animation-delay:2.6s; animation-duration:3.6s;" viewBox="0 0 24 24" fill="#D6D3F7"><path d="M12 0 C13 8 16 11 24 12 C16 13 13 16 12 24 C11 16 8 13 0 12 C8 11 11 8 12 0Z"/></svg>
      </div>
    </div>
  </nav>
</div>

<style>
  .sidebar-sparkles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .sidebar-sparkle {
    position: absolute;
    opacity: 0.6;
  }
</style>
