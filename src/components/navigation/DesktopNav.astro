---

import { Image } from 'astro:assets'
import logo from '../../../public/images/transparent-logo-bright-small.webp'

---

<div>
  {/* ********************    MAIN NAV, DOTTED BACKGROUND*****************  */}
<div
  id="sidebar"
  class="fixed left-0 top-0 w-[250px] h-screen bg-[#1334a0] px-6 pt-16 z-51 text-white border-r-4 gradient-line overflow-y-auto"
  style="background-image: url('/images/dotsBackground.png')"
>
    <div class="flex  items-center gap-4 bg-secondaryColor gradient-line border-y-2 py-4 glow ">
  <Image
  src={logo}
  alt="logo for spellman's consulting its a blue code symbol </> with a wand in place of the slash"
  width={40}
  height={40}
  loading="eager"
  fetchpriority="high"
  class="bg-secondaryColor ml-2 box-content  rounded-full hover:border-white hover:rounded-full hover:bg-white "
/>
      <p class="font-Akaya ">
        <span class="inline-block text-white text-lg lg:text-xl xl:text-2xl text-end"> Spellman's </span>
        <span class="inline-block text-white text-lg lg:text-xl xl:text-2xl "> Consulting</span>
      </p>
    </div>
    
  <ul class="flex flex-col bg-secondaryColor text-center font-Akaya text-lg lg:text-xl xl:text-2xl [&>li]:py-1 xl:[&>li]:py-2">
      <li class="glow gradient-line border-b-2 my-auto">
        <a href="/">
        Home
        </a>
      </li>
      
      <li class="glow gradient-line border-b-2">
        <a href="/#projects">
         Projects
        </a>
      </li>
      
      
      <li class="glow gradient-line border-b-2">
        <a href="/about/">About</a>
      </li>
      
      <li class="glow gradient-line border-b-2">
        <a href="/#services">
          Services
        </a>
      </li>
      
      <li class="glow gradient-line border-b-2">
        <a href="/#process">The Process</a>
      </li>
      
      <li class="glow gradient-line border-b-2">
        <a href="/#skills">Skills</a>
      </li>
      
      <li class="glow gradient-line border-b-2">
        <a href="/#contact">Contact</a>
   
      
      <li class="glow gradient-line border-b-2">
        <a href="/blog">Blog</a>
      </li>

      
      <li class="glow gradient-line border-b-2">
        <a href="/torc">Torc</a>
      </li>
    </ul>
    
    <div class="flex flex-col space-y-5 items-center justify-items-center pt-8"></div>
  </div>
</div>