---
interface Props {
  variant: "clouds" | "hills";
  fromColor: string;
  toColor: string;
  midColor?: string;
  stars?: boolean;
}

const { variant, fromColor, toColor, midColor = "var(--midnight-lavender-mid)", stars = false } = Astro.props;

const starPositions = [
  { top: "14%", left: "8%", size: 14, opacity: 0.7, hideOnMobile: false, delay: 0, duration: 3.4 },
  { top: "30%", left: "20%", size: 10, opacity: 0.6, hideOnMobile: true, delay: 0.9, duration: 4.1 },
  { top: "10%", left: "38%", size: 18, opacity: 0.85, hideOnMobile: false, delay: 1.8, duration: 3.8 },
  { top: "30%", left: "55%", size: 12, opacity: 0.65, hideOnMobile: true, delay: 2.4, duration: 4.6 },
  { top: "16%", left: "68%", size: 22, opacity: 1, hideOnMobile: false, delay: 0.5, duration: 5 },
  { top: "30%", left: "82%", size: 14, opacity: 0.7, hideOnMobile: false, delay: 3.1, duration: 3.6 },
  { top: "8%", left: "92%", size: 10, opacity: 0.6, hideOnMobile: true, delay: 1.3, duration: 4.3 },
];
---

<div class:list={["section-divider", `section-divider--${variant}`]} style={`background:${fromColor}`} aria-hidden="true">
  {stars && (
    <div class="section-divider__stars">
      {starPositions.map((star) => (
        <svg
          class:list={["section-divider__star", "twinkle", { "section-divider__star--hide-mobile": star.hideOnMobile }]}
          style={`top:${star.top}; left:${star.left}; width:${star.size}px; height:${star.size}px; opacity:${star.opacity}; animation-delay:${star.delay}s; animation-duration:${star.duration}s;`}
          viewBox="0 0 24 24"
          fill="var(--midnight-lavender)"
        >
          <path d="M12 0 C13 8 16 11 24 12 C16 13 13 16 12 24 C11 16 8 13 0 12 C8 11 11 8 12 0Z" />
        </svg>
      ))}
    </div>
  )}

  {variant === "clouds" && (
    <svg class="section-divider__svg" viewBox="0 0 1200 220" preserveAspectRatio="none">
      <g fill={midColor}><circle cx="-40" cy="133" r="41"/><circle cx="11" cy="133" r="58"/><circle cx="83" cy="129" r="56"/><circle cx="153" cy="126" r="51"/><circle cx="216" cy="135" r="61"/><circle cx="292" cy="136" r="61"/><circle cx="368" cy="136" r="41"/><circle cx="419" cy="127" r="52"/><circle cx="484" cy="120" r="61"/><circle cx="560" cy="131" r="36"/><circle cx="605" cy="133" r="54"/><circle cx="672" cy="124" r="38"/><circle cx="719" cy="127" r="61"/><circle cx="795" cy="121" r="43"/><circle cx="848" cy="133" r="49"/><circle cx="909" cy="134" r="55"/><circle cx="977" cy="130" r="37"/><circle cx="1023" cy="135" r="53"/><circle cx="1089" cy="123" r="58"/><circle cx="1161" cy="131" r="56"/><circle cx="1231" cy="124" r="36"/><rect x="0" y="130" width="1200" height="90"/></g>
      <g fill={toColor}><circle cx="-40" cy="158" r="49"/><circle cx="21" cy="161" r="53"/><circle cx="87" cy="170" r="52"/><circle cx="152" cy="150" r="46"/><circle cx="209" cy="157" r="44"/><circle cx="264" cy="151" r="50"/><circle cx="326" cy="153" r="35"/><circle cx="369" cy="165" r="41"/><circle cx="420" cy="162" r="37"/><circle cx="466" cy="153" r="47"/><circle cx="524" cy="157" r="48"/><circle cx="584" cy="156" r="30"/><circle cx="621" cy="158" r="43"/><circle cx="674" cy="162" r="35"/><circle cx="717" cy="152" r="35"/><circle cx="760" cy="169" r="34"/><circle cx="802" cy="164" r="49"/><circle cx="863" cy="154" r="34"/><circle cx="905" cy="150" r="30"/><circle cx="942" cy="156" r="36"/><circle cx="987" cy="155" r="35"/><circle cx="1030" cy="160" r="39"/><circle cx="1078" cy="167" r="36"/><circle cx="1123" cy="170" r="51"/><circle cx="1186" cy="155" r="36"/><circle cx="1231" cy="156" r="52"/><rect x="0" y="160" width="1200" height="60"/></g>
    </svg>
  )}

  {variant === "hills" && (
    <svg class="section-divider__svg" viewBox="0 0 1200 170" preserveAspectRatio="none">
      <path d="M0,110 Q220,10 460,90 T920,70 T1200,60 L1200,170 L0,170 Z" fill={midColor} />
      <path d="M0,120 Q300,60 600,130 T1200,100 L1200,170 L0,170 Z" fill={toColor} />
    </svg>
  )}
</div>

<style>
  .section-divider {
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    line-height: 0;
  }

  .section-divider__svg {
    display: block;
    position: relative;
    bottom: -2px;
    width: 100%;
    height: 200px;
  }

  .section-divider--hills .section-divider__svg {
    height: 180px;
  }

  @media (max-width: 640px) {
    .section-divider__svg {
      height: 120px;
    }

    .section-divider--hills .section-divider__svg {
      height: 100px;
    }
  }

  .section-divider__stars {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .section-divider__star {
    position: absolute;
  }

  @media (max-width: 640px) {
    .section-divider__star--hide-mobile {
      display: none;
    }
  }
</style>
