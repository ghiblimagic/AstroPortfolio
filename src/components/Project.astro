---
import { YouTube } from "@astro-community/astro-embed-youtube";

interface Props {
  webmsrc?: string;
  mp4src?: string;
  imgsrc?: string;
  youtube?: string;
   youtubePoster?: string;
  vidTitles?: string;
  projectTitle: string;
  projectLanguages: string;
  projectDescription: string;
  linkToCode?: string;
  linkToLiveSite?: string;
  loadingtype?: "eager" | "lazy";
  readmeLink?: string;
  decisionLogLink?: string;
}

const {
  webmsrc,
  mp4src,
  imgsrc,
  youtube,
  youtubePoster,
  vidTitles,
  projectTitle,
  projectLanguages,
  projectDescription,
  linkToCode,
  linkToLiveSite,
  loadingtype = "lazy",
  readmeLink,
  decisionLogLink,
} = Astro.props;
---

<article class="portfolio-card project-card fade-in">
  {(youtube || webmsrc || mp4src || imgsrc) && (
    <div class="project-thumbnail">
      {youtube ? (
        <YouTube id={youtube} poster={youtubePoster}/>
      ) : (webmsrc || mp4src) ? (
        <video controls autoplay muted loop>
          {webmsrc && <source src={webmsrc} title={vidTitles} type="video/webm" />}
          {mp4src && <source src={mp4src} title={vidTitles} type="video/mp4" />}
          Sorry, your browser doesn't support embedded videos.
        </video>
      ) : (
        <img
          src={imgsrc}
          title={vidTitles}
          loading={loadingtype}
          alt={vidTitles || projectTitle}
        />
      )}
    </div>
  )}

  <div class="project-card-content">
    <h3 class="project-titles">{projectTitle}</h3>
    <ul class="project-tech-tags" aria-label="Technologies used">
      {projectLanguages.split(",").map((language) => language.trim()).filter(Boolean).map((language) => (
        <li>{language}</li>
      ))}
    </ul>
    <p class="project-description">{projectDescription}</p>
    
    <ul class="project-actions">
      {linkToCode && (
        <li>
          <a class="portfolio-button portfolio-button--code" href={linkToCode} aria-label="Link to codebase" target="_blank" rel="noopener noreferrer">Code</a>
        </li>
      )}
      
      {linkToLiveSite && (
        <li>
          <a class="portfolio-button portfolio-button--view" href={linkToLiveSite} aria-label={`View ${projectTitle}`} target="_blank" rel="noopener noreferrer">View</a>
        </li>
      )}
      
      {readmeLink && (
        <li>
          <a class="portfolio-button portfolio-button--link" href={readmeLink} aria-label={`Read ${projectTitle} README`} target="_blank" rel="noopener noreferrer">ReadMe</a>
        </li>
      )}

    </ul>

    {decisionLogLink && (
      <div class="project-decision-action mx-auto">
        <a class="portfolio-button portfolio-button--link" href={decisionLogLink} aria-label={`Read ${projectTitle} decision log`}>Decision Log</a>
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    overflow: hidden;
  }

  .project-thumbnail {
    width: 100%;
    height: 190px;
    overflow: hidden;
  }

  .project-thumbnail :global(video),
  .project-thumbnail :global(img),
  .project-thumbnail :global(iframe) {
    display: block;
    width: 100%;
    height: 190px;
    object-fit: cover;
    border: 0;
  }

  .project-card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 28px 26px 24px;
  }

  .project-titles {
    margin: 0 0 14px;
    color: oklch(0.22 0.02 260);
    font-family: "Fraunces", Georgia, serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
  }

  .project-tech-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
    font-family: "Inter", sans-serif;
    font-size: 11.5px;
    font-weight: 600;
  }

  .project-tech-tags li {
    padding: 5px 10px;
    color: var(--navy-deep);
    background: oklch(0.94 0.03 255);
    border-radius: 999px;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin: 24px 0 0;
    padding: 20px 0 0;
    list-style: none;
    border-top: 1px solid oklch(0.93 0.006 260);
    font-family: "Inter", sans-serif;
  }

  .project-actions > li {
    flex: 0 0 auto;
  }

  .project-decision-action {
    margin-top: 10px;
    text-align: center;
  }
</style>