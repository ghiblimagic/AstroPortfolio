---
import { YouTube } from "@astro-community/astro-embed-youtube";

interface Props {
  webmsrc?: string;
  mp4src?: string;
  imgsrc?: string;
  youtube?: string;
   youtubePoster?: string;
  vidTitles?: string;
  projectTitle: string;
  projectLanguages: string;
  extraTech?: string;
  extraTechLabel?: string;
  projectDescription?: string;
  outcomeLine?: string;
  descriptionBullets?: string[];
  linkToCode?: string;
  linkToLiveSite?: string;
  loadingtype?: "eager" | "lazy";
  readmeLink?: string;
  decisionLogLink?: string;
  /** Card titles sit under whatever heading introduces the list, which is an
   * <h2> on the homepage but the page <h1> on /otherprojects. */
  headingLevel?: 2 | 3;
}

const {
  webmsrc,
  mp4src,
  imgsrc,
  youtube,
  youtubePoster,
  vidTitles,
  projectTitle,
  projectLanguages,
  extraTech,
  extraTechLabel,
  projectDescription,
  outcomeLine,
  descriptionBullets,
  linkToCode,
  linkToLiveSite,
  loadingtype = "lazy",
  readmeLink,
  decisionLogLink,
  headingLevel = 3,
} = Astro.props;

const HeadingTag = `h${headingLevel}` as const;
---

<article class="portfolio-card project-card fade-in">
  {(youtube || webmsrc || mp4src || imgsrc) && (
    <div class="project-thumbnail">
      {youtube ? (
        <YouTube id={youtube} poster={youtubePoster}/>
      ) : (webmsrc || mp4src) ? (
        <video
          controls
          muted
          playsinline
          data-autoplay
          aria-label={`Demo video: ${vidTitles || projectTitle}`}
        >
          {webmsrc && <source src={webmsrc} title={vidTitles} type="video/webm" />}
          {mp4src && <source src={mp4src} title={vidTitles} type="video/mp4" />}
          Sorry, your browser doesn't support embedded videos.
        </video>
      ) : (
        <img
          src={imgsrc}
          title={vidTitles}
          loading={loadingtype}
          alt={vidTitles || projectTitle}
        />
      )}
    </div>
  )}

  <div class="project-card-content">
    <HeadingTag class="project-titles">{projectTitle}</HeadingTag>
    {outcomeLine && <p class="project-outcome"><strong>{outcomeLine}</strong></p>}
    <ul class="project-tech-tags" aria-label="Technologies used">
      {projectLanguages.split(",").map((language) => language.trim()).filter(Boolean).map((language) => (
        <li>{language}</li>
      ))}
    </ul>

    {extraTech && (
      <details class="project-extra-tech">
        <summary class="project-link project-extra-tech-toggle">{extraTechLabel ?? "See additional tools used"}</summary>
        <ul class="project-tech-tags" aria-label={extraTechLabel ?? "Additional technologies used"}>
          {extraTech.split(",").map((tech) => tech.trim()).filter(Boolean).map((tech) => (
            <li>{tech}</li>
          ))}
        </ul>
      </details>
    )}

    {descriptionBullets ? (
      <ul class="project-description-list">
        {descriptionBullets.map((point) => <li>{point}</li>)}
      </ul>
    ) : (
      <p class="project-description">{projectDescription}</p>
    )}

    <ul class="project-actions">
      {linkToCode && (
        <li>
          <a class="project-link" href={linkToCode} aria-label="Link to codebase" target="_blank" rel="noopener noreferrer">Code</a>
        </li>
      )}

      {linkToLiveSite && (
        <li>
          <a class="project-link" href={linkToLiveSite} aria-label={`View ${projectTitle}`} target="_blank" rel="noopener noreferrer">View</a>
        </li>
      )}

      {readmeLink && (
        <li>
          <a class="project-link" href={readmeLink} aria-label={`Read ${projectTitle} README`} target="_blank" rel="noopener noreferrer">ReadMe</a>
        </li>
      )}

    </ul>

    {decisionLogLink && (
      <div class="project-decision-action mx-auto">
        <a class="project-link" href={decisionLogLink} aria-label={`Read ${projectTitle} decision log`}>Decision Log</a>
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    border-radius: 20px;
    border: 1px solid var(--midnight-lavender-border);
    box-shadow: 0 12px 32px rgba(20, 27, 77, 0.08)
  }


  .project-thumbnail {
    width: 100%;
    height: 190px;
    overflow: hidden;
    border-radius: 20px 20px 0 0;
  }

  .project-thumbnail :global(video),
  .project-thumbnail :global(img),
  .project-thumbnail :global(iframe) {
    display: block;
    width: 100%;
    height: 190px;
    object-fit: cover;
    border: 0;
  }

  .project-card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 28px 26px 24px;
  }

  .project-titles {
    margin: 0 0 14px;
    color: var(--midnight-navy);
    font-family: "AkayaKanadaka Script", serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
  }

  .project-outcome {
    margin: 0 0 14px;
    color: var(--midnight-navy);
    font-family: "Inter", sans-serif;
    font-size: 14px;
    line-height: 1.4;
  }

  .project-description-list {
    margin: 0;
    padding-left: 20px;
    color: var(--midnight-navy);
    font-family: "Inter", sans-serif;
    font-size: 13.5px;
    line-height: 1.5;
  }

  .project-description-list li + li {
    margin-top: 8px;
  }

  .project-tech-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
    font-family: "Inter", sans-serif;
    font-size: 11.5px;
    font-weight: 600;
  }

  .project-tech-tags li {
    padding: 5px 10px;
    color: var(--midnight-navy);
    background: #ffffff;
    border: 1.5px solid #7b84c4;
    border-radius: 999px;
  }

  .project-extra-tech {
    margin: 0 0 18px;
    text-align: center;
  }

  .project-extra-tech-toggle {
    cursor: pointer;
    list-style: none;
  }

  .project-extra-tech-toggle::-webkit-details-marker {
    display: none;
  }

  .project-extra-tech[open] .project-extra-tech-toggle {
    margin-bottom: 10px;
  }

  .project-extra-tech .project-tech-tags {
    margin: 0;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin: 24px 0 0;
    padding: 20px 0 0;
    list-style: none;
    border-top: 1px solid oklch(0.93 0.006 260);
    font-family: "Inter", sans-serif;
  }

  .project-actions > li {
    flex: 0 0 auto;
  }

  .project-link {
    display: inline-block;
    color: var(--midnight-navy);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--midnight-lavender);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .project-decision-action {
    margin-top: 10px;
    text-align: center;
  }
</style>

<script>
  // autoplay/loop are set here rather than in the markup so they can be skipped
  // under prefers-reduced-motion. As attributes they would take effect before
  // any script could intervene, flashing motion at users who asked for none.
  const motionOk = window.matchMedia("(prefers-reduced-motion: reduce)");

  function applyMotionPreference() {
    const videos =
      document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]");

    videos.forEach((video) => {
      if (motionOk.matches) {
        video.loop = false;
        video.pause();
      } else {
        video.loop = true;
        // a rejected play() is fine: browsers block autoplay in some contexts
        // and the controls are still there
        video.play().catch(() => {});
      }
    });
  }

  applyMotionPreference();
  motionOk.addEventListener("change", applyMotionPreference);
</script>
