---
// Sitting-cat constellation for the Contact section; clicking it shows a
// "Meow!" beside its head. Each star's
// position/size lives on a wrapping <g>; the <path> inside only twinkles.
// Putting both on one element breaks: the animation's CSS `transform`
// replaces the SVG `transform` attribute and the star jumps off its vertex.
const sparkle = "M12 0 C13 8 16 11 24 12 C16 13 13 16 12 24 C11 16 8 13 0 12 C8 11 11 8 12 0Z";
---

<div class="cat-constellation">
<button type="button" class="cat-button" aria-label="Pet the constellation cat">
<svg
  class="cat-svg"
  viewBox="0 0 240 300"
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke="#B3AEEA" stroke-opacity="0.55" stroke-width="1.4" stroke-linejoin="round">
    <polyline points="50,262 46,170 38,108 46,62 58,22 76,44 98,26 104,64 90,90 122,116 152,164 168,218 162,262 50,262" />
    <polyline points="162,262 206,256 230,224 216,190" />
  </g>

  <g fill="#D6D3F7" opacity="0.8">
    <circle cx="42" cy="140" r="1.8" />
    <circle cx="42" cy="85" r="1.8" />
    <circle cx="67" cy="33" r="1.8" />
    <circle cx="87" cy="35" r="1.8" />
    <circle cx="97" cy="78" r="1.8" />
    <circle cx="106" cy="103" r="1.8" />
    <circle cx="137" cy="140" r="1.8" />
    <circle cx="160" cy="191" r="1.8" />
    <circle cx="165" cy="240" r="1.8" />
    <circle cx="106" cy="262" r="1.8" />
    <circle cx="184" cy="259" r="1.8" />
    <circle cx="221" cy="240" r="1.8" />
    <circle cx="223" cy="207" r="1.8" />
  </g>

  <!-- Stars: translate(X - size/2, Y - size/2) scale(size/24) -->
  <!-- 50,262 (12) -->
  <g transform="translate(44 256) scale(0.5)"><path class="twinkle cstar" d={sparkle} fill="#FFFFFF" style="animation-delay: 0.3s; animation-duration: 4.2s;" /></g>
  <!-- 46,170 (8) -->
  <g transform="translate(42 166) scale(0.3333)"><path class="twinkle cstar" d={sparkle} fill="#D6D3F7" style="animation-delay: 2.1s; animation-duration: 3.4s;" /></g>
  <!-- 38,108 (11) -->
  <g transform="translate(32.5 102.5) scale(0.4583)"><path class="twinkle cstar" d={sparkle} fill="#FFFFFF" style="animation-delay: 1.2s; animation-duration: 4.7s;" /></g>
  <!-- 46,62 (12) -->
  <g transform="translate(40 56) scale(0.5)"><path class="twinkle cstar" d={sparkle} fill="#FFFFFF" style="animation-delay: 3.3s; animation-duration: 3.8s;" /></g>
  <!-- 58,22 left ear tip (15) -->
  <g transform="translate(50.5 14.5) scale(0.625)"><path class="twinkle cstar" d={sparkle} fill="#FFFFFF" style="animation-delay: 0.8s; animation-duration: 4.4s;" /></g>
  <!-- 76,44 (8) -->
  <g transform="translate(72 40) scale(0.3333)"><path class="twinkle cstar" d={sparkle} fill="#D6D3F7" style="animation-delay: 2.7s; animation-duration: 3.1s;" /></g>
  <!-- 98,26 right ear tip (15) -->
  <g transform="translate(90.5 18.5) scale(0.625)"><path class="twinkle cstar" d={sparkle} fill="#FFFFFF" style="animation-delay: 1.9s; animation-duration: 4.9s;" /></g>
  <!-- 104,64 (8) -->
  <g transform="translate(100 60) scale(0.3333)"><path class="twinkle cstar" d={sparkle} fill="#D6D3F7" style="animation-delay: 3.8s; animation-duration: 3.6s;" /></g>
  <!-- 90,90 (8) -->
  <g transform="translate(86 86) scale(0.3333)"><path class="twinkle cstar" d={sparkle} fill="#D6D3F7" style="animation-delay: 0.5s; animation-duration: 4.1s;" /></g>
  <!-- 122,116 (10) -->
  <g transform="translate(117 111) scale(0.4167)"><path class="twinkle cstar" d={sparkle} fill="#FFFFFF" style="animation-delay: 2.4s; animation-duration: 3.3s;" /></g>
  <!-- 152,164 (12) -->
  <g transform="translate(146 158) scale(0.5)"><path class="twinkle cstar" d={sparkle} fill="#FFFFFF" style="animation-delay: 1.5s; animation-duration: 4.6s;" /></g>
  <!-- 168,218 (13) -->
  <g transform="translate(161.5 211.5) scale(0.5417)"><path class="twinkle cstar" d={sparkle} fill="#FFFFFF" style="animation-delay: 3.1s; animation-duration: 3.9s;" /></g>
  <!-- 162,262 (12) -->
  <g transform="translate(156 256) scale(0.5)"><path class="twinkle cstar" d={sparkle} fill="#FFFFFF" style="animation-delay: 0.1s; animation-duration: 3.5s;" /></g>
  <!-- 206,256 (8) -->
  <g transform="translate(202 252) scale(0.3333)"><path class="twinkle cstar" d={sparkle} fill="#D6D3F7" style="animation-delay: 2.9s; animation-duration: 4.3s;" /></g>
  <!-- 230,224 (8) -->
  <g transform="translate(226 220) scale(0.3333)"><path class="twinkle cstar" d={sparkle} fill="#D6D3F7" style="animation-delay: 1.0s; animation-duration: 3.2s;" /></g>
  <!-- 216,190 tail tip (13) -->
  <g transform="translate(209.5 183.5) scale(0.5417)"><path class="twinkle cstar" d={sparkle} fill="#FFFFFF" style="animation-delay: 3.6s; animation-duration: 5s;" /></g>
</svg>
</button>
<!-- Live region so the meow is announced too; emptied again once it fades. -->
<span class="cat-meow" role="status" aria-live="polite"></span>
</div>

<script>
  const cat = document.querySelector('.cat-button');
  const meow = document.querySelector('.cat-meow');
  let hideTimer: ReturnType<typeof setTimeout> | undefined;

  if (cat && meow) {
    cat.addEventListener('click', () => {
      clearTimeout(hideTimer);
      // Clear and force a reflow so a repeat click restarts the animation.
      meow.textContent = '';
      meow.classList.remove('is-visible');
      void (meow as HTMLElement).offsetWidth;
      meow.textContent = 'Meow!';
      meow.classList.add('is-visible');
      hideTimer = setTimeout(() => {
        meow.classList.remove('is-visible');
        meow.textContent = '';
      }, 1800);
    });
  }
</script>

<style>
  .cat-constellation {
    position: relative;
    width: 144px;
    height: 180px;
    margin: 0 auto;
  }

  .cat-button {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: none;
    cursor: pointer;
  }

  /* Keep the focus ring for keyboard focus only. The global button:focus
     rule adds a dark box-shadow as well as the outline, so clear both;
     :global(#contact) is needed to outrank the #contact button:focus rule. */
  :global(#contact) .cat-button:focus:not(:focus-visible) {
    outline: none;
    box-shadow: none;
  }

  .cat-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Sits right of the head (x ~ 120-200, y ~ 20-60 in the viewBox), which is
     empty space inside the cat's own box, so it can't reach the form. */
  .cat-meow {
    position: absolute;
    left: 52%;
    top: 5%;
    font-family: "AkayaKanadaka Script", serif;
    font-size: 1.25rem;
    color: var(--midnight-white);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
  }

  .cat-meow.is-visible {
    animation: meow-pop 1.8s ease-out forwards;
  }

  @keyframes meow-pop {
    0% { opacity: 0; transform: translateY(6px) scale(0.8); }
    15% { opacity: 1; transform: none; }
    75% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(-6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-meow.is-visible {
      animation: none;
      opacity: 1;
    }
  }

  /* Scale around each star's own box, not the SVG viewport (overrides the
     global .twinkle transform-origin). */
  .cstar {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Beside the form only when it fits. Sized against the Contact section
     (a container, see .contact-section in globals.css) rather than the
     viewport, because the desktop sidebar makes the section narrower than
     100vw. With section width S = content width + 2 * 48px padding, the form
     (a centred 620px column) ends at S/2 + 310px; leaving the 34px edge
     offset and a 24px gap, the cat can be S/2 - 368px = 50cqw - 320px wide.
     It shrinks from 270px to 160px, which is reached at a 960px content
     width; narrower than that, the cat sits under the form instead. */
  @container (min-width: 960px) {
    .cat-constellation {
      position: absolute;
      right: 34px;
      top: 50%;
      transform: translateY(-50%);
      margin: 0;
      width: clamp(160px, calc(50cqw - 320px), 270px);
      height: auto;
      aspect-ratio: 240 / 300;
    }
  }
</style>
