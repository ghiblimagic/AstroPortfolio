---
interface Props {
  imgSrc: string;
}

const { imgSrc } = Astro.props;
---

<div class="diamond-anchor" aria-hidden="false">
  <div class="diamond-shadow-shape" aria-hidden="true"></div>
  <div class="diamond-gradient-shape shadow-transition-effect" aria-hidden="true"></div>
  <img
    src={`/images/${imgSrc}.svg`}
    class="diamond-icon"
    alt=""
  />
</div>

<style>
  .diamond-anchor {
    position: absolute;
    top: 0;
    left: 50%;
    width: 0;
    height: 0;
  }

  .diamond-shadow-shape,
  .diamond-gradient-shape {
    position: absolute;
    top: 0;
    left: 0;
    width: 56px;
    height: 56px;
    transform: translate(-50%, -50%) rotate(45deg);
    border-radius: 8px;
    transition: border-radius 1s ease;
  }

  .diamond-shadow-shape {
    top: 8px;
    left: 8px;
    background: var(--midnight-lavender);
  }

  .diamond-gradient-shape {
    background: var(--diamond-gradient);
  }

  /* Hovering the gradient diamond morphs both it and its lavender
     shadow into a circle together, restoring the old .icon:hover
     border-radius effect this component used to have. */
  .diamond-anchor:has(.diamond-gradient-shape:hover) .diamond-shadow-shape,
  .diamond-anchor:has(.diamond-gradient-shape:hover) .diamond-gradient-shape {
    border-radius: 50%;
  }

  .diamond-icon {
    position: absolute;
    top: 0;
    left: 0;
    width: 28px;
    max-width: none;
    height: 28px;
    transform: translate(-50%, -50%);
    filter: brightness(0) invert(1);
    pointer-events: none;
  }
</style>
