---
import CloudCap from "@/components/CloudCap.astro";
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10 my-8 justify-items-center">

	<div class="skill-card w-full">
		<CloudCap />
		<section class="portfolio-card portfolio-card--padded portfolio-card--capped w-full fade-in">

			<h3 class="heading-styling "> Languages</h3>
			<ul class="skill-pills">
					<li >TypeScript</li>
				    <li >JavaScript</li>
					<li >Python</li>
					<li >GraphQL</li>
					<li >EJS</li>
				    <li >HTML</li>
					<li >CSS</li>


			</ul>
		</section>
	</div>

	<div class="skill-card w-full">
		<CloudCap />
		<section class="portfolio-card portfolio-card--padded portfolio-card--capped w-full fade-in">
			<h3 class="heading-styling"> Frameworks & Libraries </h3>
			<ul class="skill-pills">
				<li >Next JS 12-15</li>
				<li >React</li>
				<li >Astro</li>
				<li >Gatsby</li>

			</ul>
		</section>
	</div>

	<div class="skill-card w-full">
		<CloudCap />
		<section class="portfolio-card portfolio-card--padded portfolio-card--capped w-full fade-in">
			<h3 class="heading-styling"> Back-End And Platforms</h3>
			<ul class="skill-pills">
					<li >Node.js</li>
					<li >Express</li>
					<li >MongoDB </li>
					<li >Appwrite</li>
					<li >Supabase</li>
					<li >Digital Ocean</li>

			</ul>
		</section>
	</div>


	<div class="skill-card w-full">
		<CloudCap />
		<section class="portfolio-card portfolio-card--padded portfolio-card--capped w-full fade-in">
			<h3 class="heading-styling"> Tools/Other </h3>
			<ul class="skill-pills">
					<li >TailwindCSS</li>
					<li >Git</li>
					<li >GitHub</li>
					<li >Figma</li>

					<li >Prettier</li>
					<li >Disqus</li>
					<li >Shadcn/ui</li>
					<li >Headless UI</li>
					<li >Daisy UI</li>
					<li >GIMP</li>


			</ul>
		</section>
	</div>

	<div class="skill-card w-full">
		<CloudCap />
		<section class="portfolio-card portfolio-card--padded portfolio-card--capped w-full fade-in">
			<h3 class="heading-styling text-wrap"> CMS </h3>
			<ul class="skill-pills">
				<li >WordPress</li>
				<li >Shopify</li>
				<li class="text-wrap">Decap cms</li>

			</ul>
		</section>
	</div>

	<div class="skill-card w-full">
		<CloudCap />
		<section class="portfolio-card portfolio-card--padded portfolio-card--capped w-full fade-in">
			<h3 class="heading-styling"> AI </h3>
			<ul class="skill-pills">
				<li >Open AI API</li>
				<li >ChatGPT</li>
				<li >Claude</li>
				<li >Copilot</li>

			</ul>
		</section>
	</div>

</div>
