---
import GradientButton from "../buttons/GradientButton.astro";
import Project from "../Project.astro"; // You'll need to convert this too

---

<div class="project-grid">


    <Project

     imgsrc="/images/bbs.png"
    vidTitles="Video of Be BiteSmart"
    projectTitle="Be BiteSmart℠"
    projectLanguages="WordPress, PHP, Playwright, Plausible Analytics, Github Actions"
    outcomeLine="Saved ~$207/yr in licensing costs and built a 129-test Playwright suite gating every deploy."
    descriptionBullets={[
      "Nonprofit providing free educational videos and resources to help prevent dog bite injuries in children and families.",
      "Architected a secure CI/CD pipeline for WordPress on shared hosting, with scoped SSH deploy keys and manual approval gates before production.",
      "Built custom Plausible analytics events to track engagement across videos, articles, and downloads for fundraising reporting.",
    ]}
    linkToCode="https://github.com/ghiblimagic/be-bite-smart/"
    linkToLiveSite="https://www.bebitesmart.org/"
    loadingtype="lazy"
    readmeLink="https://github.com/ghiblimagic/be-bite-smart/blob/main/README.md"
  />



  <Project
    youtube="https://youtu.be/J_oG8zlepLU"
   
    vidTitles="Video of Wipe Right"
    projectTitle="Wipe Right"
    projectLanguages=" Next.js 14, TypeScript, Tailwindcss, Supabase, Fast API, React Context, TanStack Query, Open AI, Stripe, HeroUi"
    outcomeLine="Voted best project among 10 peer teams."
