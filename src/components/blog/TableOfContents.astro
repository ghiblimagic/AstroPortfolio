---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// Prefer H2s only; posts that are mostly H3s (e.g. need-a-website) would
// otherwise get an empty TOC, so fall back to H2 + H3.
const h2s = headings.filter((h) => h.depth === 2);
const items = h2s.length >= 2 ? h2s : headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <>
    <!-- Desktop: sticky sidebar. Mobile: collapsible <details>. Which one shows
         is a container query in globals.css; the hidden one is display:none. -->
    <aside class="blog-toc blog-toc--aside" aria-labelledby="toc-heading">
      <h2 id="toc-heading" class="blog-toc__heading">ON THIS PAGE</h2>
      <ul class="blog-toc__list">
        {items.map((h) => (
          <li><a class:list={["blog-toc__link", { "blog-toc__link--sub": h.depth === 3 }]} href={`#${h.slug}`} data-toc-link>{h.text}</a></li>
        ))}
      </ul>
    </aside>

    <details class="blog-toc blog-toc--details">
      <summary class="blog-toc__summary">On this page</summary>
      <ul class="blog-toc__list">
        {items.map((h) => (
          <li><a class:list={["blog-toc__link", { "blog-toc__link--sub": h.depth === 3 }]} href={`#${h.slug}`} data-toc-link>{h.text}</a></li>
        ))}
      </ul>
    </details>
  </>
)}

<script>
  // Highlight the section being read: the last heading whose top has scrolled
  // above the trigger line. IntersectionObserver only signals *when* to
  // recompute; it cannot say which heading is "current" on its own.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
  const ids = Array.from(new Set(links.map((l) => decodeURIComponent(l.hash.slice(1)))));
  const headings = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (headings.length > 0) {
    const TRIGGER = 140;
    let current = "";

    const update = () => {
      let active = headings[0].id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= TRIGGER) active = h.id;
      }
      if (active === current) return;
      current = active;
      for (const link of links) {
        const on = decodeURIComponent(link.hash.slice(1)) === active;
        link.classList.toggle("is-current", on);
        if (on) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };

    const observer = new IntersectionObserver(update, {
      rootMargin: `-${TRIGGER}px 0px -55% 0px`,
      threshold: [0, 1],
    });
    headings.forEach((h) => observer.observe(h));
    update();
  }
</script>
