---
import '@/styles/globals.css'
import '@/styles/normalize.css'

import Layout from '@/layouts/Layout.astro';
import SpaceForDesktopSidebar from "@/components/SpaceForDesktopSidebar.astro"
import TableOfContents from "@/components/blog/TableOfContents.astro"
import CommentsSection from "@/components/blog/CommentsSection"
import GradientDivider from '@/components/ui/gradientDivider.astro'
import SectionDivider from "@/components/SectionDivider.astro"

const { slug } = Astro.params; // from the URL
console.log("slug in blogPostLayout.astro",slug)

if (!slug) {
  throw new Error(`Post not found: ${slug}`);
}

const { title, date, description, headings } = Astro.props;

---
<Layout title="Janet Spellman's Blog.">
  <main id="main-content" tabindex="-1" class="flex overflow-x-hidden bg-[var(--midnight-lavender-pale)]">
  
    <SpaceForDesktopSidebar/>
    <div class="w-full overflow-x-hidden ">
    
      <div class="sm:px-12 max-w-4xl mx-auto bg-white   text-black rounded-2xl pb-16 overflow-x-hidden">
        <article class="mx-4 overflow-x-hidden">
          <header class="mb-8">
            <h1 class="text-4xl font-bold my-6 pt-6 text-center text-[var(--midnight-navy)]">{title}</h1>
            <span class="text-white text-base mx-auto bg-[var(--midnight-navy)] group-hover:bg-[var(--midnight-navy-deep)] w-fit py-1 px-4 rounded-2xl my-6 block">
              <time datetime={date}>
                {new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </span>
            {description && <p class="text-xl mb-4 text-center">{description}</p>}
          </header>
          
          <GradientDivider/>
          
          <!-- Sidebar TOC for desktop -->
          <aside class="overflow-y-auto scrollbar-thin scrollbar-purple fade-in">
            <TableOfContents headings={headings} />
          </aside>
          
          <div class="prose prose-lg prose-headings:font-bold prose-headings:text-center max-w-none overflow-hidden">
            <!--- prose is a class from Tailwind Typography, it adds well-formatted typographic styles to markdown files -->
            <slot />
          </div>
        </article>
      </div>

      <!-- ****************** COMMMENTS ***************** -->
      <!-- Full-width navy band with the wavy hills divider on top, matching the
           homepage's Contact section at the bottom of the landing page -->

      <SectionDivider variant="hills" fromColor="var(--midnight-lavender-pale)" toColor="var(--midnight-navy)" midColor="var(--midnight-lavender)" />

      <section id="comments" class="mt-[-2px] p-4 sm:p-12 pb-20 w-full bg-[var(--midnight-navy)]">
        <CommentsSection slug={slug} currentUserId={null} client:load/>
      </section>
    </div>
  </main>
</Layout>

<script>
     import { initFadeInObserver } from "@/utils/fadeInObserver"

  document.addEventListener('DOMContentLoaded', () => {
    const proseContent = document.querySelector('.prose');
    if (proseContent) {
     // Get all direct children of prose (any element type)
      const elements = proseContent.querySelectorAll(':scope > *');
      elements.forEach((el) => {
        el.classList.add('fade-in');
      });
    
   
    }
 

// fade observer needed here because of timing
// the one in the main layout has already been ran
// so we're running it again after we're grabbed all the prose/ markdown
 initFadeInObserver()
  });
</script>

<style>
  /* Ensure no horizontal overflow anywhere */
  :global(body) {
    overflow-x: hidden;
  }
  
  /* Make sure prose content doesn't overflow */
  :global(.prose) {
    overflow-wrap: break-word;
    word-wrap: break-word;
  }
  
  /* Ensure all images and embeds are responsive */
  :global(.prose img),
  :global(.prose video),
  :global(.prose iframe) {
    max-width: 100%;
    height: auto;
  }
</style>