---
interface Props {
    title: string;
    description?: string;
    type?: "website" | "article";
    noindex?: boolean;
    jsonLd?: Record<string, unknown>[];
}
const {
    title,
    description = "Software developer portfolio covering Janet Spellman's website building services, previous projects and skills",
    type = "website",
    noindex = false,
    jsonLd = [],
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/images/thumbnail.png", Astro.site).href;
import SocialLinksNav from "../components/navigation/SocialLinksNav"
import NavToggleButton from "@/components/buttons/NavToggleButton.astro"
import { socialIcons } from "@/data/socialIcons.js"



---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <script is:inline>document.documentElement.classList.add("js");</script>
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:site_name" content="Janet Spellman" />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content="Janet Spellman, software developer" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="canonical" href={canonicalUrl} />
        {noindex && <meta name="robots" content="noindex" />}
        {jsonLd.map((data) => (
            <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
        ))}
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" fetchpriority="high" href="/images/transparent-logo-bright-small.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        
        <link rel="preload" fetchpriority="high" as="image" href="/images/dotsBackground.png" type="image/png"/>

        <link rel="preload" href="/fonts/OpenSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/OpenSans-Bold.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/AkayaKanadaka-Regular.woff2" as="font" type="font/woff2" crossorigin />

        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
 <!-- Cloudflare Web Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "cfc795e13ebd438698757185c698ac69"}'></script><!-- End Cloudflare Web Analytics -->
    </head>
    <body class="h-full relative">
        <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="social-gradient" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#D6D3F7"/>
              <stop offset="1" stop-color="#8FA7EA"/>
            </linearGradient>
            <linearGradient id="social-gradient-hover" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#FFFFFF"/>
              <stop offset="1" stop-color="#D6D3F7"/>
            </linearGradient>
          </defs>
        </svg>
        <header class="relative flex justify-between pt-5 pr-8" style="background: var(--midnight-navy);">
            <NavToggleButton />
            <SocialLinksNav />
        </header>

        <slot/>
        <footer
            id="footer"
            class="absolute bottom-0 w-full border-t-2 gradient-line flex items-center justify-between flex-wrap gap-2 pr-4"
            style="background: var(--midnight-navy-deep);">
            <small class="pl-8 text-white">&copy; Janet Spellman. All rights reserved.</small>
            <div class="flex items-center">
                {socialIcons.map((item) => (
                    <a
                        href={item.href}
                        aria-label={`Janet on ${item.label}`}
                        class="social-icon-link"
                    >
                        <svg class="social-icon-svg" viewBox={item.viewBox} aria-hidden="true">
                            <path d={item.path} />
                        </svg>
                    </a>
                ))}
            </div>
        </footer>
<script> 
import { initFadeInObserver } from "@/utils/fadeInObserver"


 initFadeInObserver()
</script>

    </body>
</html>
<style is:global>
    :root {
        --accent: 136, 58, 234;
        --accent-light: 224, 204, 250;
        --accent-dark: 49, 10, 101;
        --accent-gradient: linear-gradient(
            45deg,
            #0d1738,
            #3459a5 30%,
            #1b2f70 60%
        );
    }
    html {
        font-family: "Open Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;

        background: #13151a;
        background-size: 224px;
    }
    code {
        font-family:
            Menlo,
            Monaco,
            Lucida Console,
            Liberation Mono,
            DejaVu Sans Mono,
            Bitstream Vera Sans Mono,
            Courier New,
            monospace;
    }

</style>